-- SECTION (draggable, with content area)
-- ═══════════════════════════════════════════════════════════════
local Section = {}
Section.__index = Section

local function createSection(page, opts, overlay)
    local t = ThemeManager.Get()
    local s = setmetatable({
        _page = page, _opts = opts, _column = opts.Column or 1,
        _order = opts.Order or 999, _contentChildren = {},
    }, Section)
    local container = Mount.create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = t.Tab,
        BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y,
        Parent = page._left,
    })
    if s._column == 2 then container.Parent = page._right end
    corner(container, C.RadiusMd)
    stroke(container, t.Outline, 0.5, 1)
    ThemeManager.Bind(container, {BackgroundColor3="Tab"})
    pad(container, 6)
    list(container, 4)
    local header = Mount.create("Frame", {
        Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
        Parent = container,
    })
    local titleLbl = Mount.create("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Font = C.FontBold, TextSize = C.TextSizeHeader, TextColor3 = t.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = opts.Title or "Section", Parent = header,
    })
    ThemeManager.Bind(titleLbl, {TextColor3="Text"})
    local body = Mount.create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y, Parent = container,
    })
    list(body, C.RowGap)
    s.Instance = container
    s.Body = body
    s.TitleLabel = titleLbl
    s.Header = header
    -- drag via header (bind every non-button descendant)
    local dragState = {active = false, grab = nil, startY = 0}
    local function beginSectionDrag(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if dragState.active then return end
        dragState.active = true
        dragState.startY = input.Position.Y
        local origParent = container.Parent
        local origOrder = container.LayoutOrder
        local ghost = container:Clone()
        ghost.Parent = overlay
        ghost.Position = UDim2.fromOffset(container.AbsolutePosition.X, container.AbsolutePosition.Y)
        ghost.Size = UDim2.fromOffset(container.AbsoluteSize.X, container.AbsoluteSize.Y)
        ghost.Active = false
        for _, d in ipairs(ghost:GetDescendants()) do
            if d:IsA("GuiButton") or d:IsA("TextBox") then d.Active = false end
        end
        container.Visible = false
        local mx, my = input.Position.X, input.Position.Y
        local gx = ghost.AbsolutePosition.X
        local gy = ghost.AbsolutePosition.Y
        local moved = false
        local moveC = UserInputService.InputChanged:Connect(function(ci)
            if ci.UserInputType ~= Enum.UserInputType.MouseMovement then return end
            local dx = ci.Position.X - mx
            local dy = ci.Position.Y - my
            if math.abs(dx) > 3 or math.abs(dy) > 3 then moved = true end
            ghost.Position = UDim2.fromOffset(gx + dx, gy + dy)
        end)
        local endC
        endC = UserInputService.InputEnded:Connect(function(ei)
            if ei.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
            moveC:Disconnect()
            endC:Disconnect()
            dragState.active = false
            if not moved then
                ghost:Destroy()
                container.Visible = true
                return
            end
            local finalX = ghost.AbsolutePosition.X + ghost.AbsoluteSize.X/2
            local finalY = ghost.AbsolutePosition.Y
            local leftX = page._left.AbsolutePosition.X
            local rightX = page._right.AbsolutePosition.X
            local targetCol = 1
            if math.abs(finalX - rightX) < math.abs(finalX - leftX) then targetCol = 2 end
            local targetParent = targetCol == 1 and page._left or page._right
            local targetIdx = 1
            for i, child in ipairs(targetParent:GetChildren()) do
                if child:IsA("GuiObject") and child.LayoutOrder < 999 and child ~= container then
                    local mid = child.AbsolutePosition.Y + child.AbsoluteSize.Y/2
                    if mid < finalY then targetIdx = i + 1 end
                end
            end
            ghost:Destroy()
            container.Visible = true
            container.Parent = targetParent
            container.LayoutOrder = targetIdx
            s._column = targetCol
            s._order = targetIdx
        end)
    end
    local function bindHeader(obj)
        obj.InputBegan:Connect(beginSectionDrag)
        for _, ch in ipairs(obj:GetChildren()) do
            if ch:IsA("GuiObject") and not ch:IsA("GuiButton") then bindHeader(ch) end
        end
    end
    bindHeader(header)
    return s
end

function Section:AddToggle(o) return createToggle(self.Body, o) end
function Section:AddSlider(o) return createSlider(self.Body, o) end
function Section:AddDropdown(o) return createDropdown(self.Body, o, self._page._overlay) end
function Section:AddTextbox(o) return createTextbox(self.Body, o) end
function Section:AddButton(o) return createButton(self.Body, o) end
function Section:AddKeybind(o) return createKeybind(self.Body, o, self._page._overlay) end
function Section:AddColorPicker(o) return createColorPicker(self.Body, o, self._page._overlay) end

