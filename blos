    })
    w._screenGui = sg
    local root_frame = Mount.create("Frame", {
        Size = UDim2.fromOffset(C.W, C.H),
        Position = UDim2.new(0.5, -C.W/2, 0.5, -C.H/2),
        BackgroundColor3 = t.Background, BorderSizePixel = 0,
        ClipsDescendants = true, Parent = sg,
    })
    corner(root_frame, C.RadiusLg)
    stroke(root_frame, t.Outline, 0.5, 1)
    ThemeManager.Bind(root_frame, {BackgroundColor3="Background"})
    local scale = Mount.create("UIScale", {Scale = C.Scale}, root_frame)
    w._scale = scale
    w._root = root_frame
    -- Topbar (draggable)
    local topbar = Mount.create("Frame", {
        Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Parent = root_frame,
    })
    local logo = Mount.create("Frame", {
        Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(8, 7),
        BackgroundColor3 = t.Accent, BorderSizePixel = 0, Parent = topbar,
    })
    corner(logo, 7)
    ThemeManager.Bind(logo, {BackgroundColor3="Accent"})
    local title = Mount.create("TextLabel", {
        Size = UDim2.new(1, -50, 1, 0), Position = UDim2.fromOffset(26, 0),
        BackgroundTransparency = 1, Font = C.FontBold, TextSize = 13,
        TextColor3 = t.Text, TextXAlignment = Enum.TextXAlignment.Left,
        Text = opts.Title or "Blossom", Parent = topbar,
    })
    ThemeManager.Bind(title, {TextColor3="Text"})
    local janitor = Janitor.new()
    janitor:Add(sg)
    attachDrag(topbar, root_frame, janitor)
    w._janitor = janitor
    -- Sidebar
    local sidebar = Mount.create("Frame", {
        Size = UDim2.new(0, C.Sidebar, 1, -28), Position = UDim2.fromOffset(0, 28),
        BackgroundColor3 = t.Sidebar, BorderSizePixel = 0, Parent = root_frame,
    })
    corner(sidebar, C.RadiusLg)
    ThemeManager.Bind(sidebar, {BackgroundColor3="Sidebar"})
    local sidebarScroll = Mount.create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, -22), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 0,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = sidebar,
    })
    list(sidebarScroll, 2)
    pad(sidebarScroll, 4, 4)
    -- Search trigger
    local searchTrig = Mount.create("TextButton", {
        Size = UDim2.new(1, -8, 0, 18), Position = UDim2.new(0, 4, 1, -20),
        BackgroundColor3 = t.Element, BorderSizePixel = 0,
        Text = "", AutoButtonColor = false, Parent = sidebar,
    })
    corner(searchTrig, C.RadiusSm)
    stroke(searchTrig, t.Outline, 0.5, 1)
    ThemeManager.Bind(searchTrig, {BackgroundColor3="Element"})
    local searchLbl = Mount.create("TextLabel", {
        Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(4, 0),
        BackgroundTransparency = 1, Font = C.FontMed, TextSize = C.TextSizeSmall,
        TextColor3 = t.InactiveText, TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Search...", Parent = searchTrig,
    })
    ThemeManager.Bind(searchLbl, {TextColor3="InactiveText"})
    w._sidebar = sidebarScroll
    -- Content area
    local content = Mount.create("Frame", {
        Size = UDim2.new(1, -C.Sidebar, 1, -28), Position = UDim2.fromOffset(C.Sidebar, 28),
        BackgroundTransparency = 1, Parent = root_frame,
    })
    local tabHolder = Mount.create("Frame", {
        Size = UDim2.new(1, -C.ContentPad*2, 1, -C.ContentPad*2),
        Position = UDim2.fromOffset(C.ContentPad, C.ContentPad),
        BackgroundTransparency = 1, Parent = content,
    })
    w._tabHolder = tabHolder
    w._content = content
    -- Overlay layer for popups
    local overlay = Mount.create("Frame", {
        Size = UDim2.fromOffset(C.W, C.H),
        Position = UDim2.fromOffset(0, 0),
        BackgroundTransparency = 1, ClipsDescendants = false,
        ZIndex = 100, Parent = root_frame,
    })
    Mount.create("UIScale", {Scale = C.Scale}, overlay)
    w._overlay = overlay
    -- Search modal
    local searchModal = Mount.create("Frame", {
        Size = UDim2.fromOffset(C.W, C.H),
        BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5,
        Visible = false, ZIndex = 200, Parent = overlay,
    })
    local modalBox = Mount.create("Frame", {
        Size = UDim2.fromOffset(260, 220),
        Position = UDim2.new(0.5, -130, 0.5, -110),
        BackgroundColor3 = t.Tab, BorderSizePixel = 0, ZIndex = 201,
        Parent = searchModal,
    })
    corner(modalBox, C.RadiusMd)
    stroke(modalBox, t.Outline, 0.4, 1)
    ThemeManager.Bind(modalBox, {BackgroundColor3="Tab"})
    local modalTitle = Mount.create("TextLabel", {
        Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 6),
        BackgroundTransparency = 1, Font = C.FontBold, TextSize = 13,
        TextColor3 = t.Text, TextXAlignment = Enum.TextXAlignment.Left,
        Text = "Search", Parent = modalBox, ZIndex = 202,
    })
    ThemeManager.Bind(modalTitle, {TextColor3="Text"})
    local modalInput = Mount.create("TextBox", {
        Size = UDim2.new(1, -16, 0, 20), Position = UDim2.fromOffset(8, 28),
        BackgroundColor3 = t.Input, BorderSizePixel = 0, ZIndex = 202,
        Font = C.FontMed, TextSize = C.TextSize,
        TextColor3 = t.Text, PlaceholderColor3 = t.InactiveText,
        PlaceholderText = "Search controls...", Text = "",
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false, Parent = modalBox,
    })
    corner(modalInput, C.RadiusSm)
    pad(modalInput, 4, 0)
    ThemeManager.Bind(modalInput, {TextColor3="Text", BackgroundColor3="Input", PlaceholderColor3="InactiveText"})
    local results = Mount.create("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -60), Position = UDim2.fromOffset(8, 52),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = modalBox, ZIndex = 202,
    })
    list(results, 1)
    w._searchModal = searchModal
    w._searchInput = modalInput
    w._searchResults = results
    w._searchIndex = {}
    searchModal.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if not modalBox:IsAncestorOf(input.Source or modalBox) then
                searchModal.Visible = false
            end
        end
    end)
    searchTrig.MouseButton1Click:Connect(function()
        searchModal.Visible = true
        modalInput:CaptureFocus()
    end)
    modalInput:GetPropertyChangedSignal("Text"):Connect(function()
        local q = string.lower(modalInput.Text)
        for _, c in ipairs(results:GetChildren()) do
            if c:IsA("GuiButton") then c:Destroy() end
        end
        if q == "" then return end
        for i, entry in ipairs(w._searchIndex) do
            if string.find(string.lower(entry.Label), q, 1, true) then
                local row = Mount.create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundColor3 = t.Tab, BorderSizePixel = 0,
                    Text = "", AutoButtonColor = false,
                    LayoutOrder = i, Parent = results,
                })
                corner(row, C.RadiusSm)
                local accentBar = Mount.create("Frame", {
                    Size = UDim2.new(0, 2, 1, -6), Position = UDim2.fromOffset(0, 3),
                    BackgroundColor3 = t.Accent, BorderSizePixel = 0, Parent = row,
                })
                corner(accentBar, 1)
                ThemeManager.Bind(accentBar, {BackgroundColor3="Accent"})
                local rl = Mount.create("TextLabel", {
                    Size = UDim2.new(1, -12, 0, 12), Position = UDim2.fromOffset(8, 2),
                    BackgroundTransparency = 1, Font = C.FontBold,
                    TextSize = C.TextSizeSmall, TextColor3 = t.Text,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Text = entry.Label, Parent = row,
                })
                ThemeManager.Bind(rl, {TextColor3="Text"})
                local ctx = Mount.create("TextLabel", {
                    Size = UDim2.new(1, -12, 0, 10), Position = UDim2.fromOffset(8, 12),
                    BackgroundTransparency = 1, Font = C.FontMed,
                    TextSize = 8, TextColor3 = t.InactiveText,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Text = entry.Page .. " / " .. entry.Section .. " · " .. entry.Type,
                    Parent = row,
                })
                ThemeManager.Bind(ctx, {TextColor3="InactiveText"})
                row.MouseEnter:Connect(function() row.BackgroundColor3 = ThemeManager.Get().HoveredElement end)
                row.MouseLeave:Connect(function() row.BackgroundColor3 = ThemeManager.Get().Tab end)
                row.MouseButton1Click:Connect(function()
                    w:SelectPage(entry.PageId)
                    searchModal.Visible = false
                end)
            end
        end
    end)
    searchModal.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if input.Position.X < modalBox.AbsolutePosition.X
            or input.Position.X > modalBox.AbsolutePosition.X + modalBox.AbsoluteSize.X
            or input.Position.Y < modalBox.AbsolutePosition.Y
            or input.Position.Y > modalBox.AbsolutePosition.Y + modalBox.AbsoluteSize.Y then
                searchModal.Visible = false
            end
        end
    end)
    return w
end

function Window:AddPage(opts)
    local p = createPage(self, opts)
    p.Instance.Visible = false
    self.Pages[opts.Id or opts.Title] = p
    -- Sidebar nav
    local navGroupName = opts.Group or "General"
    local t = ThemeManager.Get()
    if not self._navGroups then self._navGroups = {} end
    if not self._navGroups[navGroupName] then
        local grpLabel = Mount.create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1,
            Font = C.FontBold, TextSize = 8, TextColor3 = t.InactiveText,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = string.upper(navGroupName), Parent = self._sidebar,
        })
        ThemeManager.Bind(grpLabel, {TextColor3="InactiveText"})
        self._navGroups[navGroupName] = {label=grpLabel}
    end
    local navItem = Mount.create("TextButton", {
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundColor3 = t.Sidebar, BorderSizePixel = 0,
        Text = "", AutoButtonColor = false, Parent = self._sidebar,
    })
    corner(navItem, C.RadiusSm)
    local navLbl = Mount.create("TextLabel", {
        Size = UDim2.new(1, -8, 1, 0), Position = UDim2.fromOffset(6, 0),
        BackgroundTransparency = 1, Font = C.FontMed, TextSize = C.TextSize,
        TextColor3 = t.InactiveText, TextXAlignment = Enum.TextXAlignment.Left,
        Text = opts.Title or "Page", Parent = navItem,
    })
    ThemeManager.Bind(navLbl, {TextColor3="InactiveText"})
    navItem.MouseEnter:Connect(function()
        if self.ActivePage ~= p then
            navItem.BackgroundColor3 = ThemeManager.Get().HoveredElement
        end
    end)
    navItem.MouseLeave:Connect(function()
        if self.ActivePage ~= p then
            navItem.BackgroundColor3 = ThemeManager.Get().Sidebar
        end
    end)
    navItem.MouseButton1Click:Connect(function()
        self:SelectPage(opts.Id or opts.Title)
    end)
    p._navItem = navItem
    p._navLbl = navLbl
    if not self.ActivePage then self:SelectPage(opts.Id or opts.Title) end
    return p
end

function Window:SelectPage(id)
    local p = self.Pages[id]
    if not p or p == self.ActivePage then return end
    for _, pg in pairs(self.Pages) do
        pg.Instance.Visible = false
        if pg._navItem then
            pg._navItem.BackgroundColor3 = ThemeManager.Get().Sidebar
            pg._navLbl.TextColor3 = ThemeManager.Get().InactiveText
        end
    end
    p.Instance.Visible = true
    if p._navItem then
        p._navItem.BackgroundColor3 = ThemeManager.Get().HoveredElement
        p._navLbl.TextColor3 = ThemeManager.Get().Accent
    end
    self.ActivePage = p
end

function Window:SetTheme(name) ThemeManager.Set(name) end
function Window:SetScale(v) self._scale.Scale = v end
function Window:Destroy()
    self._janitor:Destroy()
    table.clear(self)
    setmetatable(self, nil)
end

function Window:RegisterSearch(entry)
    table.insert(self._searchIndex, entry)
end

