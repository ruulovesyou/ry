-- ═══════════════════════════════════════════════════════════════
-- PRIMITIVES
-- ═══════════════════════════════════════════════════════════════
local Janitor = {}
Janitor.__index = Janitor
function Janitor.new() return setmetatable({_tasks={}, _isCleaning=false}, Janitor) end
function Janitor:Add(obj, method, idx)
    local key = idx or obj
    if self._tasks[key] then self:Remove(key) end
    self._tasks[key] = {obj=obj, method=method}
    return obj
end
function Janitor:Remove(idx)
    local t = self._tasks[idx]
    if t then
        self._tasks[idx] = nil
        local ok, err = pcall(function()
            if typeof(t.obj) == "RBXScriptConnection" then t.obj:Disconnect()
            elseif typeof(t.obj) == "Instance" then t.obj:Destroy()
            elseif typeof(t.obj) == "Tween" then t.obj:Cancel()
            elseif type(t.obj) == "function" then t.obj()
            elseif type(t.obj) == "table" then
                if t.method and type(t.obj[t.method]) == "function" then t.obj[t.method](t.obj)
                elseif type(t.obj.Destroy) == "function" then t.obj:Destroy()
                elseif type(t.obj.Disconnect) == "function" then t.obj:Disconnect() end
            end
        end)
        if not ok then warn("[Blossom] cleanup:", err) end
    end
end
function Janitor:Cleanup()
    if self._isCleaning then return end
    self._isCleaning = true
    for k in pairs(self._tasks) do self:Remove(k) end
    self._isCleaning = false
end
function Janitor:Destroy()
    self:Cleanup()
    table.clear(self)
    setmetatable(self, nil)
end

local Signal = {}
Signal.__index = Signal
function Signal.new() return setmetatable({_head=nil, _tail=nil}, Signal) end
function Signal:Connect(cb)
    local node = {cb=cb, next=nil, prev=self._tail, connected=true}
    if self._tail then self._tail.next = node; self._tail = node
    else self._head = node; self._tail = node end
    local conn
    conn = { Connected=true, Disconnect=function(c)
        if not node.connected then return end
        node.connected = false
        c.Connected = false
        if node.prev then node.prev.next = node.next else self._head = node.next end
        if node.next then node.next.prev = node.prev else self._tail = node.prev end
    end }
    return conn
end
function Signal:Fire(...)
    local cur = self._head
    while cur do
        local nxt = cur.next
        if cur.connected then task.spawn(cur.cb, ...) end
        cur = nxt
    end
end
function Signal:Destroy()
    local cur = self._head
    while cur do cur.connected = false; cur = cur.next end
    table.clear(self); setmetatable(self, nil)
end

local State = {}
State.__index = State
function State.new(init) return setmetatable({_value=init, _signal=Signal.new()}, State) end
function State:Get() return self._value end
function State:Set(v, silent)
    local old = self._value
    if old == v then return end
    self._value = v
    if not silent then self._signal:Fire(v, old) end
end
function State:Subscribe(cb) return self._signal:Connect(cb) end
function State:Destroy() self._signal:Destroy(); table.clear(self); setmetatable(self, nil) end

-- ═══════════════════════════════════════════════════════════════
-- MOUNT (defensive)
-- ═══════════════════════════════════════════════════════════════
local Mount = {}
function Mount.resolveTarget()
    if typeof(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui and typeof(hui) == "Instance" then return hui end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg and cg.Parent then
        local canWrite = pcall(function()
            local t = Instance.new("Folder"); t.Parent = cg; t:Destroy()
        end)
        if canWrite then return cg end
    end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end
function Mount.create(class, props, children)
    local inst = Instance.new(class)
    local parent = nil
    if type(props) == "table" then
        for k, v in pairs(props) do
            if k == "Parent" then parent = v else inst[k] = v end
        end
    end
    if type(children) == "table" then
        for _, c in ipairs(children) do
            if typeof(c) == "Instance" then c.Parent = inst end
        end
    elseif typeof(children) == "Instance" then
        parent = parent or children
    end
    if parent then
        local ok = pcall(function() inst.Parent = parent end)
        if not ok then pcall(function() inst.Parent = Mount.resolveTarget() end) end
    end
    return inst
end

local function corner(p, r) return Mount.create("UICorner", {CornerRadius=UDim.new(0, r)}, p) end
local function stroke(p, color, trans, thick)
    return Mount.create("UIStroke", {
        Color=color, Transparency=trans or 0, Thickness=thick or 1
    }, p)
end
local function list(p, gap, order)
    return Mount.create("UIListLayout", {
        Padding=UDim.new(0, gap or 0),
        SortOrder=order or Enum.SortOrder.LayoutOrder,
    }, p)
end
local function pad(p, x, y)
    return Mount.create("UIPadding", {
        PaddingLeft=UDim.new(0, x), PaddingRight=UDim.new(0, x),
        PaddingTop=UDim.new(0, y or x), PaddingBottom=UDim.new(0, y or x),
    }, p)
end

-- ═══════════════════════════════════════════════════════════════
-- THEME MANAGER
-- ═══════════════════════════════════════════════════════════════
local ThemeManager = { _current = Themes.Blossom, _signal = Signal.new() }
function ThemeManager.Get() return ThemeManager._current end
function ThemeManager.Set(name)
    local t = Themes[name]
    if not t or t == ThemeManager._current then return end
    ThemeManager._current = t
    ThemeManager._signal:Fire(t)
end
function ThemeManager.Bind(inst, propMap, janitor)
    local function apply(t)
        for prop, key in pairs(propMap) do
            inst[prop] = t[key]
        end
    end
    apply(ThemeManager._current)
    local c = ThemeManager._signal:Connect(apply)
    if janitor then janitor:Add(c) end
end

-- ═══════════════════════════════════════════════════════════════
-- DRAG CONTROLLER (recursive on non-button children)
-- ═══════════════════════════════════════════════════════════════
local function attachDrag(handle, target, janitor)
    local dragging = false
    local ds, sp = Vector2.zero, UDim2.new()
    local moveC, endC = nil, nil
    local function clampPos(pos)
        local cam = workspace.CurrentCamera
        if not cam then return pos end
        local vp, sz = cam.ViewportSize, target.AbsoluteSize
        return UDim2.new(pos.X.Scale,
            math.clamp(pos.X.Offset, -sz.X*0.5, vp.X - sz.X*0.5),
            pos.Y.Scale,
            math.clamp(pos.Y.Offset, 0, vp.Y - sz.Y*0.5))
    end
    local function cleanup()
        dragging = false
        if moveC then moveC:Disconnect(); moveC = nil end
        if endC then endC:Disconnect(); endC = nil end
    end
    local function beginDrag(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            ds = Vector2.new(input.Position.X, input.Position.Y)
            sp = target.Position
            cleanup(); dragging = true
            moveC = UserInputService.InputChanged:Connect(function(ci)
                if not dragging then return end
                if ci.UserInputType == Enum.UserInputType.MouseMovement
                or ci.UserInputType == Enum.UserInputType.Touch then
                    local d = Vector2.new(ci.Position.X, ci.Position.Y) - ds
                    target.Position = clampPos(UDim2.new(
                        sp.X.Scale, sp.X.Offset + d.X,
                        sp.Y.Scale, sp.Y.Offset + d.Y))
                end
            end)
            endC = UserInputService.InputEnded:Connect(function(ei)
                if ei.UserInputType == Enum.UserInputType.MouseButton1
                or ei.UserInputType == Enum.UserInputType.Touch then cleanup() end
            end)
        end
    end
    local function bindRecursive(obj)
        janitor:Add(obj.InputBegan:Connect(beginDrag))
        for _, child in ipairs(obj:GetChildren()) do
            if child:IsA("GuiObject") and not child:IsA("GuiButton") then
                bindRecursive(child)
            end
        end
    end
    bindRecursive(handle)
    janitor:Add(cleanup)
end

