        mode = "toggle"
        popup.Visible = false
    end)
    addPopupOpt("On Hold", function()
        mode = "hold"
        popup.Visible = false
    end)
    addPopupOpt("Reset", function()
        key = Enum.KeyCode.E
        state:Set(key)
        keyLbl.Text = key.Name
        popup.Visible = false
    end)
    local capturing = false
    local capConn = nil
    chip.MouseButton1Click:Connect(function()
        if capturing then
            capturing = false
            if capConn then capConn:Disconnect(); capConn = nil end
            keyLbl.Text = state:Get().Name
            return
        end
        local abs = chip.AbsolutePosition
        popup.Position = UDim2.fromOffset(abs.X - 55, abs.Y + 18)
        popup.Visible = not popup.Visible
        if popup.Visible then
            capturing = true
            keyLbl.Text = "..."
