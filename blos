local Window = {}
Window.__index = Window

local function createWindow(opts)
    opts = opts or {}
    local t = ThemeManager.Get()
    local w = setmetatable({ _opts = opts, Pages = {}, ActivePage = nil }, Window)
    local root = Mount.resolveTarget()
    local sg = Mount.create("ScreenGui", {
