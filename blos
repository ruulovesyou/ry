-- Button
local function createButton(parent, opts)
    local t = ThemeManager.Get()
    local btn = Mount.create("TextButton", {
        Size = UDim2.new(1, 0, 0, C.RowH),
        BackgroundColor3 = t.Element,
        BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        Parent = parent,
    })
    corner(btn, C.RadiusSm)
    ThemeManager.Bind(btn, {BackgroundColor3="Element"})
    local lbl = Mount.create("TextLabel", {
        Size = UDim2.new(1, -8, 1, 0), Position = UDim2.new(0, 4, 0, 0),
        BackgroundTransparency = 1, Font = C.FontMed, TextSize = C.TextSize,
        TextColor3 = t.Text, TextXAlignment = Enum.TextXAlignment.Center,
        Text = opts.Text or opts.Label or "Button", Parent = btn,
    })
    ThemeManager.Bind(lbl, {TextColor3="Text"})
    btn.MouseEnter:Connect(function() btn.BackgroundColor3 = ThemeManager.Get().HoveredElement end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = ThemeManager.Get().Element end)
    btn.MouseButton1Click:Connect(function()
        if opts.Callback then task.spawn(opts.Callback) end
    end)
    return {Instance=btn, SetText=function(_, s) lbl.Text = s end}
end

-- Toggle
local function createToggle(parent, opts)
    local t = ThemeManager.Get()
    local state = State.new(opts.Default or false)
    local row = Mount.create("Frame", {
        Size = UDim2.new(1, 0, 0, C.RowH),
        BackgroundTransparency = 1, Parent = parent,
    })
    local lbl = Mount.create("TextLabel", {
        Size = UDim2.new(1, -34, 1, 0), Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1, Font = C.FontMed, TextSize = C.TextSize,
        TextColor3 = t.Text, TextXAlignment = Enum.TextXAlignment.Left,
        Text = opts.Label or opts.Title or "Toggle", Parent = row,
    })
    ThemeManager.Bind(lbl, {TextColor3="Text"})
    local track = Mount.create("Frame", {
        Size = UDim2.new(0, 20, 0, 11),
        Position = UDim2.new(1, -20, 0.5, -5.5),
        BackgroundColor3 = t.Element, BorderSizePixel = 0, Parent = row,
    })
    corner(track, 6)
    local trackStroke = stroke(track, t.Outline, 0.2, 1)
    local thumb = Mount.create("Frame", {
        Size = UDim2.new(0, 7, 0, 7),
        Position = UDim2.new(0, 2, 0.5, -3.5),
        BackgroundColor3 = t.InactiveText, BorderSizePixel = 0, Parent = track,
    })
    corner(thumb, 4)
    local hb = Mount.create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, Parent = row,
    })
    local function paint()
        local v = state:Get()
        local tt = ThemeManager.Get()
        track.BackgroundColor3 = v and tt.Accent or tt.Element
        trackStroke.Color = v and tt.Accent or tt.Outline
        thumb.BackgroundColor3 = v and tt.Text or tt.InactiveText
        thumb.Position = v and UDim2.new(1, -9, 0.5, -3.5) or UDim2.new(0, 2, 0.5, -3.5)
    end
    local function set(v, fromState)
        v = v and true or false
        if v == state:Get() then return end
        if not fromState then state:Set(v) end
        paint()
        if opts.Callback then task.spawn(opts.Callback, v) end
    end
    state:Subscribe(function() paint() end)
    hb.MouseButton1Click:Connect(function() set(not state:Get()) end)
    paint()
    return {Instance=row, Get=function() return state:Get() end,
        Set=function(_, v) set(v) end, State=state}
end

-- Slider
local function createSlider(parent, opts)
    local t = ThemeManager.Get()
    local mn, mx = opts.Min or 0, opts.Max or 100
    local step = opts.Step or 1
    local val = math.clamp(opts.Default or mn, mn, mx)
    local state = State.new(val)
    local box = Mount.create("Frame", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1, Parent = parent,
    })
    local header = Mount.create("Frame", {
        Size = UDim2.new(1, 0, 0, 13), BackgroundTransparency = 1, Parent = box,
    })
    local lbl = Mount.create("TextLabel", {
        Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1,
        Font = C.FontMed, TextSize = C.TextSize, TextColor3 = t.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = opts.Label or opts.Title or "Slider", Parent = header,
    })
    ThemeManager.Bind(lbl, {TextColor3="Text"})
    local valLbl = Mount.create("TextLabel", {
        Size = UDim2.new(0, 48, 1, 0), Position = UDim2.new(1, -48, 0, 0),
        BackgroundTransparency = 1, Font = C.FontMed, TextSize = C.TextSizeSmall,
        TextColor3 = t.InactiveText, TextXAlignment = Enum.TextXAlignment.Right,
        Text = tostring(val) .. (opts.Unit or ""), Parent = header,
    })
    ThemeManager.Bind(valLbl, {TextColor3="InactiveText"})
    local track = Mount.create("TextButton", {
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 1, -6),
        BackgroundColor3 = t.Inline, BorderSizePixel = 0,
        Text = "", AutoButtonColor = false, Parent = box,
    })
    corner(track, 2)
    ThemeManager.Bind(track, {BackgroundColor3="Inline"})
    local fill = Mount.create("Frame", {
        Size = UDim2.new((val-mn)/(mx-mn), 0, 1, 0),
        BackgroundColor3 = t.Accent, BorderSizePixel = 0, Parent = track,
    })
    corner(fill, 2)
    ThemeManager.Bind(fill, {BackgroundColor3="Accent"})
    local knob = Mount.create("Frame", {
        Size = UDim2.new(0, 7, 0, 7),
        Position = UDim2.new((val-mn)/(mx-mn), -3.5, 0.5, -3.5),
        BackgroundColor3 = t.Text, BorderSizePixel = 0, Parent = track,
    })
    corner(knob, 4)
    ThemeManager.Bind(knob, {BackgroundColor3="Text"})
    local function paint()
        local v = state:Get()
        local p = math.clamp((v-mn)/(mx-mn), 0, 1)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, -3.5, 0.5, -3.5)
        valLbl.Text = tostring(v) .. (opts.Unit or "")
    end
    local function set(v)
        v = math.clamp(math.round((v-mn)/step)*step + mn, mn, mx)
        if v == state:Get() then return end
        state:Set(v)
    end
    state:Subscribe(function()
        paint()
        if opts.Callback then task.spawn(opts.Callback, state:Get()) end
    end)
    local dragging = false
    local moveC, endC = nil, nil
    local function update(pos)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local r = math.clamp(pos.X - track.AbsolutePosition.X, 0, w)
        set(mn + (mx-mn) * (r/w))
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(Vector2.new(input.Position.X, input.Position.Y))
            if moveC then moveC:Disconnect() end
            if endC then endC:Disconnect() end
            moveC = UserInputService.InputChanged:Connect(function(ci)
                if dragging and (ci.UserInputType == Enum.UserInputType.MouseMovement
                or ci.UserInputType == Enum.UserInputType.Touch) then
                    update(Vector2.new(ci.Position.X, ci.Position.Y))
                end
            end)
            endC = UserInputService.InputEnded:Connect(function(ei)
                if ei.UserInputType == Enum.UserInputType.MouseButton1
                or ei.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
        end
    end)
    paint()
    return {Instance=box, Get=function() return state:Get() end,
        Set=function(_, v) set(v) end, State=state}
end

