    })
    ThemeManager.Bind(arrow, {TextColor3="InactiveText"})
    local popup = Mount.create("Frame", {
        Size = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = t.Tab, BorderSizePixel = 0,
        Visible = false, Parent = overlay,
    })
    corner(popup, C.RadiusMd)
    stroke(popup, t.Outline, 0.3, 1)
    ThemeManager.Bind(popup, {BackgroundColor3="Tab"})
    local scroll = Mount.create("ScrollingFrame", {
        Size = UDim2.new(1, -8, 1, -8), Position = UDim2.new(0, 4, 0, 4),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = popup,
    })
    list(scroll, 1)
    local optBtns = {}
    local function rebuild()
        for _, b in ipairs(optBtns) do b:Destroy() end
        optBtns = {}
        for i, opt in ipairs(opts.Options or {}) do
            local o = Mount.create("TextButton", {
                Size = UDim2.new(1, 0, 0, 18),
                BackgroundColor3 = state:Get() == opt and ThemeManager.Get().HoveredElement or ThemeManager.Get().Tab,
                BorderSizePixel = 0, Text = "", AutoButtonColor = false,
                LayoutOrder = i, Parent = scroll,
            })
            corner(o, C.RadiusSm)
            local ol = Mount.create("TextLabel", {
                Size = UDim2.new(1, -6, 1, 0), Position = UDim2.new(0, 3, 0, 0),
                BackgroundTransparency = 1, Font = C.FontMed, TextSize = C.TextSizeSmall,
                TextColor3 = state:Get() == opt and ThemeManager.Get().Accent or ThemeManager.Get().Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = tostring(opt), Parent = o,
            })
            o.MouseEnter:Connect(function() o.BackgroundColor3 = ThemeManager.Get().HoveredElement end)
            o.MouseLeave:Connect(function()
                o.BackgroundColor3 = state:Get() == opt
                    and ThemeManager.Get().HoveredElement
                    or ThemeManager.Get().Tab
            end)
            o.MouseButton1Click:Connect(function()
                state:Set(opt)
                lbl.Text = tostring(opt)
                open = false
                popup.Visible = false
                arrow.Text = "v"
                if opts.Callback then task.spawn(opts.Callback, opt) end
            end)
            table.insert(optBtns, o)
        end
        local h = #optBtns * 19 + 8
        popup.Size = UDim2.new(0, row.AbsoluteSize.X, 0, math.min(h, 120))
        scroll.CanvasSize = UDim2.new(0, 0, 0, #optBtns * 19)
    end
    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            rebuild()
            local abs = btn.AbsolutePosition
            local sz = btn.AbsoluteSize
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
            local popH = popup.Size.Y.Offset
            local yPos = abs.Y + sz.Y + 2
            if yPos + popH > vp.Y then yPos = abs.Y - popH - 2 end
            popup.Position = UDim2.fromOffset(abs.X, yPos)
        end
        popup.Visible = open
        arrow.Text = open and "^" or "v"
    end)
    return {Instance=row, Get=function() return state:Get() end,
        Set=function(_, v) state:Set(v); lbl.Text = tostring(v) end, State=state}
end

