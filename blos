-- PAGE (two columns)
-- ═══════════════════════════════════════════════════════════════
local Page = {}
Page.__index = Page

local function createPage(window, opts)
    local t = ThemeManager.Get()
    local p = setmetatable({ _window = window, _opts = opts }, Page)
    local page = Mount.create("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Visible = false, Parent = window._tabHolder,
    })
    local left = Mount.create("ScrollingFrame", {
        Size = UDim2.new(0.5, -C.ColumnGap/2, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = page,
    })
    list(left, C.RowGap)
    local right = Mount.create("ScrollingFrame", {
        Size = UDim2.new(0.5, -C.ColumnGap/2, 1, 0),
        Position = UDim2.new(0.5, C.ColumnGap/2, 0, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = page,
    })
    list(right, C.RowGap)
    p.Instance = page
    p._left = left
    p._right = right
    p._overlay = window._overlay
    p.Sections = {}
    return p
end

function Page:AddSection(opts)
    local s = createSection(self, opts, self._overlay)
    table.insert(self.Sections, s)
    return s
end

