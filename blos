        local abs = animDrop.AbsolutePosition
        animList.Position = UDim2.fromOffset(abs.X, abs.Y + 18)
        animList.Visible = not animList.Visible
    end)
    local function paint()
        local c = Color3.fromHSV(curH, curS, curV)
        state:Set(c, true)
        swatch.BackgroundColor3 = c
        sv.BackgroundColor3 = Color3.fromHSV(curH, 1, 1)
        svKnob.Position = UDim2.new(curS, -3, 1-curV, -3)
        hueThumb.Position = UDim2.new(curH, -2, 0.5, -5)
        alphaBar.BackgroundColor3 = c
        if opts.Callback then task.spawn(opts.Callback, c, curA, animMode) end
    end
    local draggingSV, draggingHue
    local function updateSV(pos)
        local sz = sv.AbsoluteSize
        if sz.X <= 0 or sz.Y <= 0 then return end
        curS = math.clamp((pos.X - sv.AbsolutePosition.X)/sz.X, 0, 1)
        curV = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y)/sz.Y, 0, 1)
        paint()
    end
    local function updateHue(pos)
        local sz = hueBar.AbsoluteSize
        if sz.X <= 0 then return end
        curH = math.clamp((pos.X - hueBar.AbsolutePosition.X)/sz.X, 0, 1)
        paint()
    end
    sv.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSV = true; updateSV(Vector2.new(input.Position.X, input.Position.Y))
        end
    end)
    hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingHue = true; updateHue(Vector2.new(input.Position.X, input.Position.Y))
        end
    end)
    UserInputService.InputChanged:Connect(function(ci)
        if ci.UserInputType == Enum.UserInputType.MouseMovement then
            if draggingSV then updateSV(Vector2.new(ci.Position.X, ci.Position.Y)) end
            if draggingHue then updateHue(Vector2.new(ci.Position.X, ci.Position.Y)) end
        end
    end)
    UserInputService.InputEnded:Connect(function(ei)
        if ei.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSV = false; draggingHue = false
        end
    end)
    swatch.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            local abs = swatch.AbsolutePosition
            local cam = workspace.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
            local yPos = abs.Y + 20
            if yPos + 200 > vp.Y then yPos = abs.Y - 200 - 4 end
            popup.Position = UDim2.fromOffset(abs.X, yPos)
        end
        popup.Visible = isOpen
    end)
    paint()
    return {Instance=box, Get=function() return state:Get() end}
end

