            TextColor3 = t.Text, TextXAlignment = Enum.TextXAlignment.Left,
            Text = choice, Parent = b,
        })
        b.MouseEnter:Connect(function() b.BackgroundColor3 = ThemeManager.Get().HoveredElement end)
        b.MouseLeave:Connect(function() b.BackgroundColor3 = ThemeManager.Get().Tab end)
        b.MouseButton1Click:Connect(function()
            animMode = choice
            animLbl.Text = "Animations: " .. choice
            animList.Visible = false
        end)
    end
