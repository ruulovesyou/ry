    local function paint()
        local tt = (val - mn) / (mx - mn)
        fill.Size = UDim2.new(tt, 0, 1, 0)
        knob.Position = UDim2.new(tt, -7, 0.5, -7)
        valLbl.Text = tostring(val) .. (o.Suffix or "")
    end

    local function setVal(v, fromFlag)
        v = math.clamp(v, mn, mx)
        if step >= 1 then v = math.floor(v / step + 0.5) * step end
        if v == val then return end
        val = v
        paint()
        if flag and not fromFlag then lib:SetFlag(flag, val) end
        if o.Callback then pcall(o.Callback, val) end
    end

    local dragging = false
    local function update(i)
        local r = math.clamp((i.Position.X - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
        setVal(mn + r * (mx - mn))
    end
    trackBg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; update(i)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    if flag then
        lib:OnFlagChanged(flag, function(v) if v ~= val then setVal(v, true) end end)
    end

    paint()
    return self:_Element(box, o, {
        get = function() return val end,
        set = function(v) setVal(v) end,
        refresh = paint,
    })
end

function Lib:_RangeSlider(parent, o)
    o = o or {}
