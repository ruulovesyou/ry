--[[
    Neutral UI — v2
    Same public API as v1. Rebuilt from a token layer up.

    Theme: edit Lib.Theme (flat table) before calling Lib.new / :Window.
    Canonical usage:
        local Lib = loadstring(...)()
        local ui  = Lib.new({ Name = "Oxrus", Folder = "Oxrus" })
        local win = ui:Window({ Title = "Oxrus" })
        local tab = win:Tab("General")
        tab:Toggle({ Text = "Auto farm", Flag = "autofarm" })
]]

local TS  = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local HS  = game:GetService("HttpService")
local GS  = game:GetService("GuiService")

local Lib = {}
Lib.__index = Lib
Lib.Name   = "UI"
Lib.Folder = "UILib"

-- Tokens ----------------------------------------------------------------
-- Flat on purpose so Lib.Theme.accent = ... still works.
Lib.Theme = {
    -- surfaces, lowest to highest
    canvas       = Color3.fromRGB(14, 15, 19),
    sunken       = Color3.fromRGB(17, 18, 23),
    surface      = Color3.fromRGB(22, 23, 29),
    surfaceAlt   = Color3.fromRGB(30, 31, 39),
    surfaceHover = Color3.fromRGB(38, 40, 50),
    border       = Color3.fromRGB(44, 46, 58),
    borderStrong = Color3.fromRGB(66, 69, 84),
    -- text
    text         = Color3.fromRGB(236, 237, 242),
    textDim      = Color3.fromRGB(164, 167, 180),
    textMuted    = Color3.fromRGB(116, 119, 134),
    -- the one accent
    accent       = Color3.fromRGB(116, 146, 218),
    accentDim    = Color3.fromRGB(96, 124, 190),
    accentSoft   = Color3.fromRGB(36, 46, 70),
    focus        = Color3.fromRGB(170, 192, 246),
    onAccent     = Color3.fromRGB(12, 14, 22),
    -- semantic (status only)
    success      = Color3.fromRGB(96, 198, 150),
    warn         = Color3.fromRGB(228, 178, 94),
    danger       = Color3.fromRGB(228, 108, 108),
    -- shape
    rSm = UDim.new(0, 6),
    rMd = UDim.new(0, 10),
    -- type
    f     = Enum.Font.Gotham,
    fm    = Enum.Font.GothamMedium,
    fb    = Enum.Font.GothamBold,
    fMono = Enum.Font.Code,
    fCaption = 11,
    fBody    = 13,
    fTitle   = 15,
    fCode    = 12,
    -- space
    xs = 4, sm = 8, md = 12, lg = 16, xl = 24,
    -- motion
    tw     = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    twFast = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    -- layout
    headerH      = 40,
    sidebarW     = 168,
    statusH      = 28,
    rowH         = 36,
    compactBelow = 760,   -- viewport width where nav moves to a top strip
}

-- Helpers ---------------------------------------------------------------
local function inst(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function tw(o, props, ti)
    if not o or not o.Parent then return end
    local t = TS:Create(o, ti or Lib.Theme.tw, props)
    t:Play()
    return t
end

local function conn(bag, sig, fn)
    local c = sig:Connect(fn)
    if bag then table.insert(bag, c) end
    return c
end

local function corner(parent, r)
    return inst("UICorner", {CornerRadius = r or Lib.Theme.rSm}, parent)
end

local function stroke(parent, color, transparency, thickness)
    return inst("UIStroke", {
        Color = color or Lib.Theme.border,
        Transparency = transparency or 0,
        Thickness = thickness or 1,
    }, parent)
end

local function pad(parent, x, y)
    return inst("UIPadding", {
        PaddingLeft = UDim.new(0, x), PaddingRight = UDim.new(0, x),
        PaddingTop = UDim.new(0, y), PaddingBottom = UDim.new(0, y),
    }, parent)
end

local function vlist(parent, gap)
    return inst("UIListLayout", {
        Padding = UDim.new(0, gap or 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, parent)
end

local function text(parent, props)
    local T = Lib.Theme
    local p = {
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = T.text,
        Font = T.f,
        TextSize = T.fBody,
        TextXAlignment = Enum.TextXAlignment.Left,
    }
    for k, v in pairs(props or {}) do p[k] = v end
    return inst("TextLabel", p, parent)
end

local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch
end

local function isMove(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch
end

-- base-color / hover / pressed / foreground for each button style
local function styleOf(T, style)
    if style == "primary" then
        return T.accent, T.focus, T.accentDim, T.onAccent
    elseif style == "danger" then
        return T.danger, T.danger:Lerp(Color3.new(1, 1, 1), 0.1),
               T.danger:Lerp(Color3.new(0, 0, 0), 0.2), T.onAccent
    elseif style == "ghost" then
        return T.surface, T.surfaceAlt, T.surfaceHover, T.textDim
    end
    return T.surfaceAlt, T.surfaceHover, T.border, T.text
end

-- hover + pressed tints. Pass a base that matches the element's resting color.
local function hoverable(btn, base, hover, press)
    btn.AutoButtonColor = false
    btn.MouseEnter:Connect(function() tw(btn, {BackgroundColor3 = hover}) end)
    btn.MouseLeave:Connect(function() tw(btn, {BackgroundColor3 = base}) end)
    btn.MouseButton1Down:Connect(function()
        tw(btn, {BackgroundColor3 = press or hover}, Lib.Theme.twFast)
    end)
    btn.MouseButton1Up:Connect(function()
        tw(btn, {BackgroundColor3 = hover}, Lib.Theme.twFast)
    end)
end

-- 2px focus ring, shown only when the object is selected by keyboard/gamepad
local function focusRing(obj, bag)
    local T = Lib.Theme
    local ring = inst("UIStroke", {Color = T.focus, Thickness = 2, Transparency = 1}, obj)
    conn(bag, obj.SelectionGained, function() tw(ring, {Transparency = 0}, T.twFast) end)
    conn(bag, obj.SelectionLost,   function() tw(ring, {Transparency = 1}, T.twFast) end)
    return ring
end

local function iconBtn(parent, pos, glyph)
    local T = Lib.Theme
    local b = inst("TextButton", {
        Size = UDim2.fromOffset(28, 28), Position = pos,
        BackgroundColor3 = T.surface, BorderSizePixel = 0,
        Text = glyph, TextColor3 = T.textDim,
        Font = T.fm, TextSize = 16, AutoButtonColor = false, ZIndex = 3,
    }, parent)
    corner(b)
    hoverable(b, T.surface, T.surfaceAlt, T.surfaceHover)
    focusRing(b, {})
    return b
end

-- standard input shell: sunken box, optional hint line below
local function field(parent)
    local T = Lib.Theme
    local wrap = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    }, parent)
    vlist(wrap, 4)
    local box = inst("Frame", {
        Size = UDim2.new(1, 0, 0, T.rowH), BackgroundColor3 = T.sunken,
        BorderSizePixel = 0, LayoutOrder = 1,
    }, wrap)
    corner(box)
    local st = stroke(box, T.border, 0.2)
    local hint = text(wrap, {
        Size = UDim2.new(1, 0, 0, 14), TextColor3 = T.textMuted,
        TextSize = T.fCaption, Visible = false, LayoutOrder = 2,
    })
    return wrap, box, st, hint
end

local function keyFromName(name)
    if type(name) ~= "string" then return nil end
    local ok, k = pcall(function() return Enum.KeyCode[name] end)
    return ok and k or nil
end

-- root ------------------------------------------------------------------
function Lib.new(opts)
    opts = opts or {}
    local self = setmetatable({}, Lib)
    self.Name      = opts.Name or "UI"
    self.Folder    = opts.Folder or "UILib"
    self._flags    = {}
    self._flagSigs = {}
    self._conns    = {}
    self._windows  = {}
    if makefolder and isfolder and not isfolder(self.Folder) then
        pcall(makefolder, self.Folder)
    end
    if opts.AutoLoad and readfile then
        task.defer(function() self:LoadConfig(opts.AutoLoad) end)
    end
    return self
end

-- flags -----------------------------------------------------------------
function Lib:GetFlag(name)
    return (self._flags or {})[name]
end

function Lib:SetFlag(name, value)
    if not name then return end
    self._flags    = self._flags or {}
    self._flagSigs = self._flagSigs or {}
    local prev = self._flags[name]
    self._flags[name] = value
    local sigs = self._flagSigs[name]
    if sigs and prev ~= value then
        for _, fn in ipairs(sigs) do
            task.spawn(function() pcall(fn, value) end)
        end
    end
end

function Lib:OnFlagChanged(name, fn)
    if not name then return end
    self._flagSigs = self._flagSigs or {}
    self._flagSigs[name] = self._flagSigs[name] or {}
    table.insert(self._flagSigs[name], fn)
    return fn
end

function Lib:_GetInitial(flag, default)
    if not flag then return default end
    local existing = self:GetFlag(flag)
    if existing ~= nil then return existing end
    self:SetFlag(flag, default)
    return default
end

-- serialization for non-JSON types --------------------------------------
local function encode(v)
    if typeof(v) == "Color3" then
        return {__t = "Color3", r = v.R, g = v.G, b = v.B}
    end
    if type(v) == "table" then
        local out = {}
        for k, vv in pairs(v) do out[k] = encode(vv) end
        return out
    end
    return v
end

local function decode(v)
    if type(v) == "table" then
        if v.__t == "Color3" then
            return Color3.new(v.r or 1, v.g or 1, v.b or 1)
        end
        local out = {}
        for k, vv in pairs(v) do out[k] = decode(vv) end
        return out
    end
    return v
end

-- config ----------------------------------------------------------------
function Lib:SaveConfig(name)
    name = name or "default"
    if not writefile then return end
    if makefolder and isfolder and not isfolder(self.Folder) then
        pcall(makefolder, self.Folder)
    end
    local data = {}
    for k, v in pairs(self._flags or {}) do
        local ty = typeof(v)
        if ty ~= "function" and ty ~= "RBXScriptSignal"
        and ty ~= "Instance" and ty ~= "EnumItem" then
            data[k] = encode(v)
        end
    end
    local ok = pcall(function()
        writefile(self.Folder .. "/" .. name .. ".json", HS:JSONEncode(data))
    end)
    if ok then
        self:Notify({Title = "Config saved", Body = name, Type = "success"})
    else
        self:Notify({Title = "Config save failed", Body = name, Type = "error"})
    end
end

function Lib:LoadConfig(name)
    name = name or "default"
    if not readfile then return end
    local ok, data = pcall(function()
        return HS:JSONDecode(readfile(self.Folder .. "/" .. name .. ".json"))
    end)
    if not ok or type(data) ~= "table" then
        self:Notify({Title = "Config load failed", Body = name, Type = "error"})
        return
    end
    for k, v in pairs(data) do self:SetFlag(k, decode(v)) end
    self:Notify({Title = "Config loaded", Body = name, Type = "success"})
end

function Lib:DeleteConfig(name)
    name = name or "default"
    if not delfile then return end
    pcall(function() delfile(self.Folder .. "/" .. name .. ".json") end)
    self:Notify({Title = "Config deleted", Body = name, Type = "warn"})
end

function Lib:ListConfigs()
    if not listfiles then return {} end
    local out = {}
    local ok, files = pcall(function() return listfiles(self.Folder) end)
    if ok then
        for _, f in ipairs(files) do
            local n = f:match("([^/\\]+)%.json$")
            if n then table.insert(out, n) end
        end
    end
    return out
end

-- notifications ---------------------------------------------------------
function Lib:_EnsureNotifStack()
    if self._notifStack and self._notifStack.Parent then return end
    local par = self._gui or (gethui and gethui()) or game:GetService("CoreGui")
    self._notifStack = inst("Frame", {
        Name = "Notifications",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -16),
        Size = UDim2.fromOffset(300, 420),
        BackgroundTransparency = 1,
        ZIndex = 100,
    }, par)
    inst("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
    }, self._notifStack)
end

function Lib:Notify(opts)
    opts = opts or {}
    self:_EnsureNotifStack()
    local T = self.Theme
    local tone = T.accent
    if opts.Type == "error" then tone = T.danger
    elseif opts.Type == "warn" then tone = T.warn
    elseif opts.Type == "success" then tone = T.success end

    self._notifN = (self._notifN or 0) + 1
    local card = inst("CanvasGroup", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = T.surfaceAlt,
        BorderSizePixel = 0,
        GroupTransparency = 1,
        LayoutOrder = self._notifN,
    }, self._notifStack)
    corner(card)
    stroke(card, T.border, 0.3)
    inst("Frame", {
        Size = UDim2.new(0, 3, 1, -16), Position = UDim2.fromOffset(0, 8),
        BackgroundColor3 = tone, BorderSizePixel = 0,
    }, card)
    text(card, {
        Size = UDim2.new(1, -28, 0, 18), Position = UDim2.fromOffset(14, 10),
        Text = opts.Title or "Notice", Font = T.fm,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    text(card, {
        Size = UDim2.new(1, -28, 0, 16), Position = UDim2.fromOffset(14, 30),
        Text = opts.Body or "", TextColor3 = T.textDim, TextSize = T.fCaption,
        TextTruncate = Enum.TextTruncate.AtEnd,
    })
    tw(card, {GroupTransparency = 0}, T.tw)
    task.delay(opts.Duration or 3, function()
        if not card.Parent then return end
        tw(card, {GroupTransparency = 1}, T.tw)
        task.wait(T.tw.Time)
        if card.Parent then card:Destroy() end
    end)
    return card
end

-- dialog ----------------------------------------------------------------
function Lib:Dialog(opts)
    opts = opts or {}
    local T = self.Theme
    local par = self._gui or (gethui and gethui()) or game:GetService("CoreGui")

    local overlay = inst("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 200,
    }, par)
    local backdrop = inst("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.5, Text = "", AutoButtonColor = false, ZIndex = 200,
    }, overlay)

    local dlg = inst("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(360, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = T.surface, BorderSizePixel = 0, Active = true, ZIndex = 201,
    }, overlay)
    corner(dlg, T.rMd)
    stroke(dlg, T.border)
    pad(dlg, T.xl, T.xl)
    vlist(dlg, T.md)

    text(dlg, {
        Size = UDim2.new(1, 0, 0, 20), Text = opts.Title or "Confirm",
        Font = T.fb, TextSize = T.fTitle, LayoutOrder = 1, ZIndex = 202,
    })
    text(dlg, {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Text = opts.Body or "", TextColor3 = T.textDim, TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, ZIndex = 202,
    })

    local row = inst("Frame", {
        Size = UDim2.new(1, 0, 0, T.rowH), BackgroundTransparency = 1,
        LayoutOrder = 3, ZIndex = 202,
    }, dlg)
    inst("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, T.sm),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, row)

    local cancel = inst("TextButton", {
        Size = UDim2.fromOffset(96, T.rowH), BackgroundColor3 = T.surfaceAlt,
        BorderSizePixel = 0, Text = opts.CancelText or "Cancel",
        TextColor3 = T.text, Font = T.fm, TextSize = T.fBody,
        AutoButtonColor = false, LayoutOrder = 1, ZIndex = 202,
    }, row)
    corner(cancel)
    hoverable(cancel, T.surfaceAlt, T.surfaceHover, T.border)
    focusRing(cancel, {})

    local base, hover, press, fg = styleOf(T, opts.Danger and "danger" or "primary")
    local confirm = inst("TextButton", {
        Size = UDim2.fromOffset(96, T.rowH), BackgroundColor3 = base,
        BorderSizePixel = 0, Text = opts.ConfirmText or "Confirm",
        TextColor3 = fg, Font = T.fm, TextSize = T.fBody,
        AutoButtonColor = false, LayoutOrder = 2, ZIndex = 202,
    }, row)
    corner(confirm)
    hoverable(confirm, base, hover, press)
    focusRing(confirm, {})

    local escConn
    local function dismiss(cb)
        if escConn then escConn:Disconnect() end
        if overlay.Parent then overlay:Destroy() end
        if cb then pcall(cb) end
    end
    confirm.MouseButton1Click:Connect(function() dismiss(opts.OnConfirm) end)
    cancel.MouseButton1Click:Connect(function() dismiss(opts.OnCancel) end)
    backdrop.MouseButton1Click:Connect(function() dismiss(opts.OnCancel) end)
    escConn = UIS.InputBegan:Connect(function(i)
        if i.KeyCode == Enum.KeyCode.Escape then dismiss(opts.OnCancel) end
    end)

    -- keyboard/gamepad users land on the safe action
    pcall(function() GS.SelectedObject = cancel end)
    return dlg
end

-- window ----------------------------------------------------------------
function Lib:Window(opts)
    opts = opts or {}
    local T   = self.Theme
    local lib = self
    local win = {_lib = self, _tabs = {}, _conns = {}, _active = nil}
    local cam = workspace.CurrentCamera
    local W, H = opts.Width or 640, opts.Height or 460
    local guiPar = (gethui and gethui()) or game:GetService("CoreGui")

    local gui = inst("ScreenGui", {
        Name = self.Name, ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 50,
    }, guiPar)
    win._gui = gui
    if not self._gui then self._gui = gui end
    table.insert(self._windows, win)

    local root = inst("Frame", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(W, H),
        BackgroundColor3 = T.canvas, BorderSizePixel = 0, ClipsDescendants = true,
    }, gui)
    corner(root, T.rMd)
    stroke(root, T.border)
    win._root = root

    -- header
    local header = inst("Frame", {
        Name = "Header", Size = UDim2.new(1, 0, 0, T.headerH),
        BackgroundColor3 = T.surface, BorderSizePixel = 0, ZIndex = 2,
    }, root)
    text(header, {
        Size = UDim2.new(1, -88, 1, 0), Position = UDim2.fromOffset(T.lg, 0),
        Text = opts.Title or self.Name, Font = T.fm, TextSize = T.fTitle,
        TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2,
    })
    inst("Frame", {
        Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = T.border, BorderSizePixel = 0, ZIndex = 2,
    }, header)
    local btnMin   = iconBtn(header, UDim2.new(1, -68, 0.5, -14), "–")
    local btnClose = iconBtn(header, UDim2.new(1, -36, 0.5, -14), "×")

    -- navigation (sidebar on desktop, top strip when compact)
    local side = inst("ScrollingFrame", {
        Name = "Nav", BackgroundColor3 = T.surface, BorderSizePixel = 0,
        ScrollBarThickness = 0, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.XY, ZIndex = 1,
    }, root)
    pad(side, T.sm, T.sm)
    local navLayout = inst("UIListLayout", {
        Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder,
    }, side)
    local divider = inst("Frame", {
        Name = "NavDivider", BackgroundColor3 = T.border,
        BorderSizePixel = 0, ZIndex = 2,
    }, root)

    -- content
    local content = inst("ScrollingFrame", {
        Name = "Content", BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = T.borderStrong,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, root)
    pad(content, T.xl, T.lg)
    win._content = content

    -- status bar (lazy)
    local statusBar, statusText
    local collapsed = false
    local compact = false

    local function layout()
        local vx, vy = cam.ViewportSize.X, cam.ViewportSize.Y
        compact = vx < T.compactBelow
        if collapsed then
            root.Size = UDim2.new(root.Size.X.Scale, root.Size.X.Offset, 0, T.headerH)
        elseif compact then
            root.Size = UDim2.fromOffset(math.min(W, vx - 24), math.min(H, vy - 24))
        else
            root.Size = UDim2.fromOffset(W, H)
        end

        local top = T.headerH
        local f = statusBar and T.statusH or 0
        local navH = 48

        if compact then
            side.Position = UDim2.fromOffset(0, top)
            side.Size = UDim2.new(1, 0, 0, navH)
            side.ScrollingDirection = Enum.ScrollingDirection.X
            navLayout.FillDirection = Enum.FillDirection.Horizontal
            navLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            divider.Visible = false
            divider.Position = UDim2.fromOffset(0, top + navH)
            divider.Size = UDim2.new(1, 0, 0, 1)
            content.Position = UDim2.fromOffset(0, top + navH + 1)
            content.Size = UDim2.new(1, 0, 1, -(top + navH + 1 + f))
            content.ScrollBarThickness = 0
        else
            side.Position = UDim2.fromOffset(0, top)
            side.Size = UDim2.new(0, T.sidebarW, 1, -(top + f))
            side.ScrollingDirection = Enum.ScrollingDirection.Y
            navLayout.FillDirection = Enum.FillDirection.Vertical
            navLayout.VerticalAlignment = Enum.VerticalAlignment.Top
            divider.Visible = true
            divider.Position = UDim2.new(0, T.sidebarW, 0, top)
            divider.Size = UDim2.new(0, 1, 1, -(top + f))
            content.Position = UDim2.fromOffset(T.sidebarW + 1, top)
            content.Size = UDim2.new(1, -(T.sidebarW + 1), 1, -(top + f))
            content.ScrollBarThickness = 3
        end

        for _, e in ipairs(win._tabs) do
            e.btn.Size = compact and UDim2.fromOffset(124, 32) or UDim2.new(1, 0, 0, 32)
            if compact then
                e.indicator.Size = UDim2.new(1, -16, 0, 2)
                e.indicator.Position = UDim2.new(0, 8, 1, -2)
            else
                e.indicator.Size = UDim2.fromOffset(2, 14)
                e.indicator.Position = UDim2.new(0, 0, 0.5, -7)
            end
        end

        local show = not collapsed
        side.Visible = show
        content.Visible = show
        divider.Visible = show and divider.Visible
        if statusBar then statusBar.Visible = show end
    end

    -- drag by header
    local dragging, dragStart, startPos = false, nil, nil
    conn(win._conns, header.InputBegan, function(i)
        if isPress(i) then
            dragging = true
            dragStart = i.Position
            startPos = root.Position
        end
    end)
    conn(win._conns, UIS.InputEnded, function(i)
        if isPress(i) then dragging = false end
    end)
    conn(win._conns, UIS.InputChanged, function(i)
        if dragging and isMove(i) then
            local d = i.Position - dragStart
            root.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    conn(win._conns, cam:GetPropertyChangedSignal("ViewportSize"), layout)
    layout()

    btnMin.MouseButton1Click:Connect(function()
        collapsed = not collapsed
        layout()
    end)

    function win:Close()
        for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
        table.clear(self._conns)
        if self._gui then
            if lib._gui == self._gui then lib._gui = nil end
            self._gui:Destroy()
        end
    end
    btnClose.MouseButton1Click:Connect(function() win:Close() end)

    function win:SetVisible(v) self._root.Visible = v ~= false end

    function win:SetStatusBar(txt)
        if not statusBar then
            statusBar = inst("Frame", {
                Name = "Status", Size = UDim2.new(1, 0, 0, T.statusH),
                Position = UDim2.new(0, 0, 1, -T.statusH),
                BackgroundColor3 = T.surface, BorderSizePixel = 0, ZIndex = 2,
            }, root)
            inst("Frame", {
                Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.border,
                BorderSizePixel = 0, ZIndex = 2,
            }, statusBar)
            statusText = text(statusBar, {
                Size = UDim2.new(1, -2 * T.lg, 1, 0), Position = UDim2.fromOffset(T.lg, 0),
                Text = txt or "", TextColor3 = T.textMuted, TextSize = T.fCaption, ZIndex = 2,
            })
            layout()
        else
            statusText.Text = txt or ""
        end
    end

    function win:SelectTab(name)
        for _, e in ipairs(self._tabs) do
            e.on = e.name == name
            e.paint()
        end
        self._active = name
    end

    function win:Tab(name, icon)
        local page = inst("Frame", {
            Name = name, Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false,
        }, content)
        vlist(page, T.md)

        local btn = inst("TextButton", {
            Name = name, Size = UDim2.new(1, 0, 0, 32),
            BackgroundColor3 = T.surface, BorderSizePixel = 0,
            Text = "", AutoButtonColor = false, LayoutOrder = #win._tabs + 1,
        }, side)
        corner(btn)
        local indicator = inst("Frame", {
            Size = UDim2.fromOffset(2, 14), Position = UDim2.new(0, 0, 0.5, -7),
            BackgroundColor3 = T.accent, BorderSizePixel = 0, Visible = false,
        }, btn)

        local labelX = T.md
        if icon then
            inst("ImageLabel", {
                Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, T.md, 0.5, -7),
                BackgroundTransparency = 1, Image = icon, ImageColor3 = T.textDim,
            }, btn)
            labelX = T.md + 20
        end
        local lbl = text(btn, {
            Size = UDim2.new(1, -labelX - T.sm, 1, 0), Position = UDim2.fromOffset(labelX, 0),
            Text = name, TextColor3 = T.textDim, Font = T.fm,
        })
        focusRing(btn, win._conns)

        local entry = {name = name, btn = btn, indicator = indicator, page = page, on = false}
        entry.paint = function()
            tw(btn, {BackgroundColor3 = entry.on and T.accentSoft or T.surface})
            tw(lbl, {TextColor3 = entry.on and T.text or T.textDim})
            indicator.Visible = entry.on
            page.Visible = entry.on
        end
        table.insert(win._tabs, entry)

        btn.MouseEnter:Connect(function()
            if not entry.on then tw(btn, {BackgroundColor3 = T.surfaceAlt}) end
        end)
        btn.MouseLeave:Connect(function()
            if not entry.on then tw(btn, {BackgroundColor3 = T.surface}) end
        end)
        btn.MouseButton1Click:Connect(function() win:SelectTab(name) end)

        if not win._active then win:SelectTab(name) end
        layout()
        return lib:_MakeAPI(page)
    end

    return win
end

function Lib:CloseAll()
    for _, w in ipairs(self._windows or {}) do
        if w.Close then pcall(function() w:Close() end) end
    end
    self._windows = {}
end

-- API builder: tabs and sections share one method set ------------------
local ELEMENTS = {
    "Button", "ButtonRow", "ConfirmButton", "Toggle", "Checkbox", "RadioGroup",
    "Slider", "RangeSlider", "Stepper", "Dropdown", "Textbox", "NumberInput",
    "SearchInput", "Keybind", "ColorPicker", "Label", "Paragraph",
    "ProgressBar", "Image", "CodeViewer",
}

function Lib:_MakeAPI(container)
    local lib = self
    local api = {Frame = container, Lib = self}
    for _, name in ipairs(ELEMENTS) do
        local method = lib["_" .. name]
        api[name] = function(_, o) return method(lib, container, o) end
    end
    function api:Divider() return lib:_Divider(container) end
    function api:Spacer(h) return lib:_Spacer(container, h) end
    function api:SubTabs(names) return lib:_SubTabs(container, names) end
    function api:Section(name, o)
        o = o or {}
        local holder
        if o.Collapsible then
            holder = lib:_Collapsible(container, name, o.DefaultOpen).Container
        else
            holder = lib:_GroupBox(container, name)
        end
        return lib:_MakeAPI(holder)
    end
    return api
end

