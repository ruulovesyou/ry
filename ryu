        Position = UDim2.fromOffset(14, 44),
        BackgroundTransparency = 1,
        Text = opts.Body or "",
        TextColor3 = t.textDim,
        Font = t.f, TextSize = t.fMd,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        ZIndex = 202,
    }, dlg)

    local cancel = inst("TextButton", {
        Size = UDim2.fromOffset(140, 34),
        Position = UDim2.new(0, 14, 1, -48),
        BackgroundColor3 = t.surfaceAlt,
        BorderSizePixel = 0,
        Text = opts.CancelText or "cancel",
        TextColor3 = t.text,
        Font = t.fm, TextSize = t.fMd,
        AutoButtonColor = false,
        ZIndex = 202,
    }, dlg)
    inst("UICorner", {CornerRadius = t.rSm}, cancel)

    local confirm = inst("TextButton", {
        Size = UDim2.fromOffset(140, 34),
        Position = UDim2.new(1, -154, 1, -48),
        BackgroundColor3 = t.accent,
        BorderSizePixel = 0,
