    confirm.MouseButton1Click:Connect(function()
        close()
        if opts.OnConfirm then pcall(opts.OnConfirm) end
    end)
    cancel.MouseButton1Click:Connect(function()
        close()
        if opts.OnCancel then pcall(opts.OnCancel) end
    end)
    overlay.MouseButton1Click:Connect(function()
        close()
        if opts.OnCancel then pcall(opts.OnCancel) end
    end)
    return dlg
end

function Lib:Window(opts)
    opts = opts or {}
    local t = self.Theme
    local win = {_lib = self, _tabs = {}, _conns = {}}

    local guiPar = (gethui and gethui()) or game:GetService("CoreGui")
    local gui = inst("ScreenGui", {
        Name = self.Name,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, guiPar)
    win._gui = gui
    if not self._gui then self._gui = gui end

    local root = inst("Frame", {
        Name = "Window",
        Size = UDim2.fromOffset(opts.Width or 620, opts.Height or 480),
        Position = UDim2.new(0.5, -310, 0.5, -240),
        BackgroundColor3 = t.bg,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, gui)
    inst("UICorner", {CornerRadius = t.rMd}, root)
    inst("UIStroke", {Color = t.border, Thickness = 1}, root)
    win._root = root

    local sc = inst("UIScale", {Scale = 1}, root)
    local cam = workspace.CurrentCamera
    local function upd() sc.Scale = math.clamp(cam.ViewportSize.X / 1280, 0.7, 1.0) end
    upd()
    conn(win._conns, cam:GetPropertyChangedSignal("ViewportSize"), upd)

    local tb = inst("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = t.surface,
        BorderSizePixel = 0,
    }, root)
    inst("TextLabel", {
        Size = UDim2.new(1, -100, 1, 0),
        Position = UDim2.fromOffset(14, 0),
        BackgroundTransparency = 1,
        Text = opts.Title or self.Name,
        TextColor3 = t.text,
        Font = t.fb, TextSize = t.fLg,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, tb)

    local function mkBtn(x, glyph, hoverCol)
        local b = inst("TextButton", {
            Size = UDim2.fromOffset(24, 22),
            Position = UDim2.new(1, x, 0, 7),
            BackgroundColor3 = t.surfaceAlt,
            BorderSizePixel = 0,
            Text = glyph,
            TextColor3 = t.textDim,
            Font = t.fm, TextSize = 14,
            AutoButtonColor = false,
        }, tb)
        inst("UICorner", {CornerRadius = t.rSm}, b)
        b.MouseEnter:Connect(function() tw(b, {BackgroundColor3 = hoverCol or t.surfaceHover}) end)
        b.MouseLeave:Connect(function() tw(b, {BackgroundColor3 = t.surfaceAlt}) end)
        return b
    end
    local btnMin   = mkBtn(-58, "—")
    local btnClose = mkBtn(-30, "×", t.danger)

    local side = inst("Frame", {
        Name = "Sidebar",
        Position = UDim2.fromOffset(0, 36),
        Size = UDim2.new(0, 150, 1, -36),
        BackgroundColor3 = t.surface,
        BorderSizePixel = 0,
    }, root)
    inst("Frame", {
        Size = UDim2.new(0, 1, 1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = t.border,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
    }, side)
    local tabList = inst("Frame", {
        Size = UDim2.new(1, -12, 1, -20),
        Position = UDim2.fromOffset(6, 10),
        BackgroundTransparency = 1,
    }, side)
    inst("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, tabList)
    win._sidebar = side
    win._tabList = tabList

    local content = inst("ScrollingFrame", {
        Name = "Content",
        Position = UDim2.fromOffset(151, 36),
        Size = UDim2.new(1, -151, 1, -36),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = t.border,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, root)
    inst("UIPadding", {
        PaddingTop = UDim.new(0, t.padL),
        PaddingBottom = UDim.new(0, t.padL),
        PaddingLeft = UDim.new(0, t.padL),
        PaddingRight = UDim.new(0, t.padL),
    }, content)
    inst("UIListLayout", {
        Padding = UDim.new(0, 16),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, content)
    win._content = content

    local statusBar
    function win:SetStatusBar(text)
        if not statusBar then
            statusBar = inst("Frame", {
                Size = UDim2.new(1, 0, 0, 26),
                Position = UDim2.new(0, 0, 1, -26),
                BackgroundColor3 = t.surfaceAlt,
                BorderSizePixel = 0,
                ZIndex = 3,
            }, root)
            inst("TextLabel", {
                Size = UDim2.new(1, -20, 1, 0),
                Position = UDim2.fromOffset(10, 0),
                BackgroundTransparency = 1,
                Text = text or "",
                TextColor3 = t.textDim,
                Font = t.fm, TextSize = t.fSm,
                TextXAlignment = Enum.TextXAlignment.Left,
                Name = "StatusText",
            }, statusBar)
            content.Size = UDim2.new(1, -151, 1, -62)
            side.Size    = UDim2.new(0, 150, 1, -62)
        else
            statusBar.StatusText.Text = text
        end
    end

    local drag, ds, sp
    conn(win._conns, tb.InputBegan, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; ds = i.Position; sp = root.Position
            conn(win._conns, i.Changed, function()
                if i.UserInputState == Enum.UserInputState.End then drag = false end
            end)
        end
    end)
    conn(win._conns, UIS.InputChanged, function(i)
        if not drag then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then
            local d = i.Position - ds
            root.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
        end
    end)

    local minimized, saveSize = false, root.Size
    btnMin.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            saveSize = root.Size
            root.Size = UDim2.fromOffset(root.Size.X.Offset, 36)
            side.Visible = false
            content.Visible = false
            if statusBar then statusBar.Visible = false end
        else
            root.Size = saveSize
            side.Visible = true
            content.Visible = true
            if statusBar then statusBar.Visible = true end
        end
    end)

    function win:Close()
        for _,c in ipairs(self._conns) do c:Disconnect() end
        self._conns = {}
        if self._gui then self._gui:Destroy() end
    end
    function win:SetVisible(v) self._root.Visible = v ~= false end
    btnClose.MouseButton1Click:Connect(function() win:Close() end)

    function win:Tab(name, icon)
        local page = inst("Frame", {
            Name = name,
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            AutomaticSize = Enum.AutomaticSize.Y,
            Visible = false,
        }, content)
        inst("UIListLayout", {
            Padding = UDim.new(0, 16),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, page)

        local btn = inst("TextButton", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = t.surface,
            BorderSizePixel = 0,
            Text = "", AutoButtonColor = false,
        }, tabList)
        inst("UICorner", {CornerRadius = t.rSm}, btn)

        local acc = inst("Frame", {
            Size = UDim2.new(0, 3, 0.55, 0),
            Position = UDim2.new(0, 0, 0.225, 0),
            BackgroundColor3 = t.accent,
            BorderSizePixel = 0,
            Visible = false,
        }, btn)

        if icon then
            inst("ImageLabel", {
                Size = UDim2.fromOffset(14, 14),
                Position = UDim2.new(0, 16, 0.5, -7),
                BackgroundTransparency = 1,
                Image = icon,
                ImageColor3 = t.textDim,
            }, btn)
        else
            inst("Frame", {
                Size = UDim2.fromOffset(5, 5),
                Position = UDim2.new(0, 20, 0.5, -2.5),
                BackgroundColor3 = t.textMuted,
                BorderSizePixel = 0,
            }, btn)
        end

        local lbl = inst("TextLabel", {
            Size = UDim2.new(1, -40, 1, 0),
            Position = UDim2.fromOffset(36, 0),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = t.textDim,
            Font = t.fm, TextSize = t.fMd,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, btn)

        local function setAct(on)
            btn.BackgroundColor3 = on and t.surfaceAlt or t.surface
            lbl.TextColor3 = on and t.text or t.textDim
            acc.Visible = on
            page.Visible = on
            local icn = btn:FindFirstChildOfClass("ImageLabel")
            if icn then icn.ImageColor3 = on and t.accent or t.textDim end
        end
        self._tabs[name] = setAct
        btn.MouseButton1Click:Connect(function()
            for _,f in pairs(self._tabs) do f(false) end
            self._activeTab = name
            setAct(true)
        end)
        btn.MouseEnter:Connect(function()
            if self._activeTab ~= name then tw(btn, {BackgroundColor3 = t.surfaceAlt}) end
        end)
        btn.MouseLeave:Connect(function()
            if self._activeTab ~= name then tw(btn, {BackgroundColor3 = t.surface}) end
        end)
        if not self._activeTab then self._activeTab = name; setAct(true) end

        return self._lib:_MakeTabAPI(page)
    end

    return win
end

function Lib:_MakeTabAPI(page)
    local tab = {Frame = page, Lib = self}

    function tab:Section(name, opts)
        opts = opts or {}
        if opts.Collapsible then
            local c = self.Lib:_Collapsible(page, name, opts.DefaultOpen)
            return self.Lib:_MakeSectionAPI(c.Container)
        else
            local box = self.Lib:_GroupBox(page, name)
            return self.Lib:_MakeSectionAPI(box)
        end
    end

    function tab:SubTabs(names) return self.Lib:_SubTabs(page, names) end

    function tab:Button(o)        return self.Lib:_Button(page, o) end
    function tab:ButtonRow(o)     return self.Lib:_ButtonRow(page, o) end
    function tab:ConfirmButton(o) return self.Lib:_ConfirmButton(page, o) end
    function tab:Toggle(o)        return self.Lib:_Toggle(page, o) end
    function tab:Checkbox(o)      return self.Lib:_Checkbox(page, o) end
    function tab:RadioGroup(o)    return self.Lib:_RadioGroup(page, o) end
    function tab:Slider(o)        return self.Lib:_Slider(page, o) end
    function tab:RangeSlider(o)   return self.Lib:_RangeSlider(page, o) end
    function tab:Stepper(o)       return self.Lib:_Stepper(page, o) end
    function tab:Dropdown(o)      return self.Lib:_Dropdown(page, o) end
    function tab:Textbox(o)       return self.Lib:_Textbox(page, o) end
    function tab:NumberInput(o)   return self.Lib:_NumberInput(page, o) end
    function tab:SearchInput(o)   return self.Lib:_SearchInput(page, o) end
    function tab:Keybind(o)       return self.Lib:_Keybind(page, o) end
    function tab:ColorPicker(o)   return self.Lib:_ColorPicker(page, o) end
    function tab:Label(o)         return self.Lib:_Label(page, o) end
    function tab:Paragraph(o)     return self.Lib:_Paragraph(page, o) end
    function tab:Divider()        return self.Lib:_Divider(page) end
    function tab:Spacer(h)        return self.Lib:_Spacer(page, h) end
    function tab:ProgressBar(o)   return self.Lib:_ProgressBar(page, o) end
    function tab:Image(o)         return self.Lib:_Image(page, o) end
    function tab:CodeViewer(o)    return self.Lib:_CodeViewer(page, o) end

    return tab
end

