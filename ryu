    }, box)

    inst("TextLabel", {
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(1, -26, 0.5, -10),
        BackgroundTransparency = 1,
        Text = "▾",
        TextColor3 = t.textDim,
        Font = t.fm, TextSize = 12,
    }, box)

    local btn = inst("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, ZIndex = 3,
    }, box)

    local list = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 1, 4),
        BackgroundColor3 = t.surfaceAlt,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 4,
    }, box)
    inst("UICorner", {CornerRadius = t.rSm}, list)
    inst("UIStroke", {Color = t.border, Thickness = 1}, list)
    inst("UIPadding", {
        PaddingTop = UDim.new(0, 6),
        PaddingBottom = UDim.new(0, 6),
        PaddingLeft = UDim.new(0, 4),
        PaddingRight = UDim.new(0, 4),
    }, list)

    local searchBox
    if searchable then
        searchBox = inst("TextBox", {
            Size = UDim2.new(1, -8, 0, 24),
            Position = UDim2.fromOffset(4, 4),
            BackgroundColor3 = t.surface,
            BorderSizePixel = 0,
            Text = "",
            PlaceholderText = "search...",
            PlaceholderColor3 = t.textMuted,
            TextColor3 = t.text,
            Font = t.fm, TextSize = t.fSm,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false,
            ZIndex = 5,
        }, list)
        inst("UICorner", {CornerRadius = t.rSm}, searchBox)
        inst("UIPadding", {PaddingLeft = UDim.new(0, 6)}, searchBox)
    end

    local scroller = inst("ScrollingFrame", {
        Size = UDim2.new(1, -8, 0, 0),
        Position = UDim2.fromOffset(4, searchable and 32 or 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = t.border,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 5,
    }, list)
    inst("UIListLayout", {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, scroller)

    local optionButtons = {}

    local function rebuild(filter)
        for _, b in ipairs(optionButtons) do b:Destroy() end
        optionButtons = {}
        filter = (filter or ""):lower()
        for i, opt in ipairs(opts) do
            if filter == "" or tostring(opt):lower():find(filter, 1, true) then
                local ob = inst("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    BackgroundColor3 = t.surfaceAlt,
                    BorderSizePixel = 0,
                    Text = "  " .. tostring(opt),
                    TextColor3 = t.text,
                    Font = t.fm, TextSize = t.fMd,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    LayoutOrder = i,
                    ZIndex = 6,
                }, scroller)
                inst("UICorner", {CornerRadius = t.rSm}, ob)
                ob.MouseEnter:Connect(function() tw(ob, {BackgroundColor3 = t.surfaceHover}) end)
                ob.MouseLeave:Connect(function() tw(ob, {BackgroundColor3 = t.surfaceAlt}) end)
                ob.MouseButton1Click:Connect(function()
                    if multi then
                        current[opt] = not current[opt] or nil
                    else
                        current = opt
                        open = false
                        list.Visible = false
                        box.Size = UDim2.new(1, 0, 0, 36)
                    end
                    valLbl.Text = displayValue()
                    if flag then lib:SetFlag(flag, current) end
                    if o.Callback then pcall(o.Callback, current) end
                end)
                table.insert(optionButtons, ob)
            end
        end
    end

    local function resize()
        local n = #optionButtons
        local h = n * 26 + 12 + (searchable and 32 or 0)
        list.Size = UDim2.new(1, 0, 0, h)
        scroller.Size = UDim2.new(1, -8, 0, n * 26)
        box.Size = open and UDim2.new(1, 0, 0, 36 + h + 4) or UDim2.new(1, 0, 0, 36)
    end

    local function toggle()
        open = not open
        list.Visible = open
        if open then rebuild(searchBox and searchBox.Text or "") resize() end
        if not open then box.Size = UDim2.new(1, 0, 0, 36) end
    end

    btn.MouseButton1Click:Connect(toggle)
    if searchBox then
        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            rebuild(searchBox.Text) resize()
        end)
    end

    rebuild()

    if flag then
        lib:OnFlagChanged(flag, function(v)
            if multi then
                if type(v) == "table" then current = v end
            else
                current = v
            end
            valLbl.Text = displayValue()
        end)
    end

    return self:_Element(box, o, {
        get = function() return current end,
        set = function(v) current = v; valLbl.Text = displayValue() end,
        refresh = function() rebuild(); resize() end,
    })
end

