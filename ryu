-- keybind ---------------------------------------------------------------
function Lib:_Keybind(parent, o)
    o = o or {}
    local T = self.Theme
    local lib = self
    local flag = o.Flag or o.Id
    local mode = o.Mode or "tap"
    local key = o.Default

    local existing = flag and lib:GetFlag(flag)
    if type(existing) == "string" then
        key = keyFromName(existing) or key
    elseif flag and existing == nil and key then
        lib:SetFlag(flag, key.Name)
    end

    local bag = {}
    local row = inst("Frame", {
        Size = UDim2.new(1, 0, 0, T.rowH), BackgroundColor3 = T.surface, BorderSizePixel = 0,
    }, parent)
    corner(row)
    stroke(row, T.border, 0.4)
    text(row, {
        Size = UDim2.new(1, -120, 1, 0), Position = UDim2.fromOffset(T.md, 0),
        Text = o.Text or o.Title or "Keybind", Font = T.fm,
    })

    local chip = inst("TextButton", {
        Size = UDim2.fromOffset(96, 24), Position = UDim2.new(1, -T.md - 96, 0.5, -12),
        BackgroundColor3 = T.sunken, BorderSizePixel = 0, Text = "",
        AutoButtonColor = false,
    }, row)
    corner(chip)
    local chipStroke = stroke(chip, T.border)
    focusRing(chip, bag)
    chip.MouseEnter:Connect(function() tw(chip, {BackgroundColor3 = T.surfaceHover}) end)
    chip.MouseLeave:Connect(function() tw(chip, {BackgroundColor3 = T.sunken}) end)

    local listening = false
    local function paintChip()
        if listening then
            chip.Text = "Press a key…"
            chip.TextColor3 = T.accent
            chipStroke.Color = T.accent
        else
            chip.Text = key and key.Name or "None"
            chip.TextColor3 = key and T.text or T.textMuted
            chipStroke.Color = T.border
        end
    end

    chip.MouseButton1Click:Connect(function()
        listening = not listening
        paintChip()
    end)

    conn(bag, UIS.InputBegan, function(input, gp)
        if listening then
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            listening = false
            if input.KeyCode == Enum.KeyCode.Escape then
                paintChip()
                return
            end
            key = input.KeyCode
            if flag then lib:SetFlag(flag, key.Name) end
            if o.Callback then pcall(o.Callback, key, false) end
            paintChip()
            return
        end
        if key and input.KeyCode == key and not gp then
            if o.Callback then pcall(o.Callback, key, true) end
        end
    end)
    if mode == "hold" then
        conn(bag, UIS.InputEnded, function(input)
            if key and input.KeyCode == key and o.OnRelease then
                pcall(o.OnRelease, key)
            end
        end)
    end

    if flag then
        lib:OnFlagChanged(flag, function(v)
            local k = keyFromName(v)
            if k then key = k; paintChip() end
        end)
    end
    paintChip()

    return self:_Element(row, o, {
        conns = bag,
        get = function() return key end,
        set = function(v)
            if typeof(v) == "EnumItem" then key = v
            elseif type(v) == "string" then key = keyFromName(v) or key end
            paintChip()
        end,
        refresh = paintChip,
    })
end

-- color picker -----------------------------------------------------------
function Lib:_ColorPicker(parent, o)
    o = o or {}
    local T = self.Theme
    local lib = self
    local flag = o.Flag or o.Id
    local cur = lib:_GetInitial(flag, o.Default or Color3.new(1, 1, 1))
    if typeof(cur) ~= "Color3" then cur = Color3.new(1, 1, 1) end
    local hue, sat, val = Color3.toHSV(cur)
    local bag = {}

    local box = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 160), BackgroundColor3 = T.surface, BorderSizePixel = 0,
    }, parent)
    corner(box)
    stroke(box, T.border, 0.4)
    text(box, {
        Size = UDim2.new(1, -90, 0, 18), Position = UDim2.fromOffset(T.md, 8),
        Text = o.Text or o.Title or "Color", Font = T.fm,
    })
    local swatch = inst("Frame", {
        Size = UDim2.fromOffset(56, 20), Position = UDim2.new(1, -T.md - 56, 0, 8),
        BackgroundColor3 = cur, BorderSizePixel = 0,
    }, box)
    corner(swatch)
    stroke(swatch, T.border)

    local sv = inst("Frame", {
        Size = UDim2.new(1, -2 * T.md, 0, 96), Position = UDim2.fromOffset(T.md, 36),
        BackgroundColor3 = Color3.new(1, 0, 0), BorderSizePixel = 0, ClipsDescendants = true,
    }, box)
    corner(sv)
    local white = inst("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, sv)
    inst("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1),
        }),
    }, white)
    local shade = inst("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0,
    }, sv)
    inst("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1),
        }),
    }, shade)
    local svKnob = inst("Frame", {
        Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3,
    }, sv)
    corner(svKnob, UDim.new(1, 0))
    stroke(svKnob, Color3.new(0, 0, 0))

    local hueBar = inst("Frame", {
        Size = UDim2.new(1, -2 * T.md, 0, 10), Position = UDim2.new(0, T.md, 0, 140),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, box)
    corner(hueBar, UDim.new(1, 0))
    inst("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
        }),
    }, hueBar)
    local hKnob = inst("Frame", {
        Size = UDim2.fromOffset(4, 16), AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3,
    }, hueBar)
    corner(hKnob, UDim.new(0, 2))
    stroke(hKnob, Color3.new(0, 0, 0))

    local function paint(silent)
        cur = Color3.fromHSV(hue, sat, val)
        swatch.BackgroundColor3 = cur
        sv.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        svKnob.Position = UDim2.new(sat, 0, 1 - val, 0)
        hKnob.Position = UDim2.new(hue, 0, 0.5, 0)
        if not silent then
            if flag then lib:SetFlag(flag, cur) end
            if o.Callback then pcall(o.Callback, cur) end
        end
    end

    local drag
    local function fromSV(i)
        sat = math.clamp((i.Position.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
        val = 1 - math.clamp((i.Position.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
        paint()
    end
    local function fromHue(i)
        hue = math.clamp((i.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
        paint()
    end
    sv.InputBegan:Connect(function(i)
        if isPress(i) then drag = "sv"; fromSV(i) end
    end)
    hueBar.InputBegan:Connect(function(i)
        if isPress(i) then drag = "hue"; fromHue(i) end
    end)
    conn(bag, UIS.InputChanged, function(i)
        if drag and isMove(i) then
            if drag == "sv" then fromSV(i) else fromHue(i) end
        end
    end)
    conn(bag, UIS.InputEnded, function(i)
        if isPress(i) then drag = nil end
    end)

    paint(true)
    if flag then
        lib:OnFlagChanged(flag, function(c)
            if typeof(c) == "Color3" and c ~= cur then
                hue, sat, val = Color3.toHSV(c)
                paint(true)
            end
        end)
    end

    return self:_Element(box, o, {
        conns = bag,
        get = function() return cur end,
        set = function(c)
            if typeof(c) ~= "Color3" then return end
            hue, sat, val = Color3.toHSV(c)
            paint()
        end,
        refresh = function() paint(true) end,
    })
end

-- progress / code --------------------------------------------------------
function Lib:_ProgressBar(parent, o)
    o = o or {}
    local T = self.Theme
    local wrap = inst("Frame", {
        Size = UDim2.new(1, 0, 0, o.Title and 28 or 6), BackgroundTransparency = 1,
    }, parent)
    local pct
    if o.Title then
        text(wrap, {
            Size = UDim2.new(1, -64, 0, 16), Text = o.Title,
            TextColor3 = T.textDim, TextSize = T.fCaption,
        })
        pct = text(wrap, {
            Size = UDim2.new(0, 60, 0, 16), Position = UDim2.new(1, -60, 0, 0),
            TextColor3 = T.textDim, TextSize = T.fCaption, Font = T.fm,
            TextXAlignment = Enum.TextXAlignment.Right,
        })
    end
    local bg = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 6),
        Position = UDim2.new(0, 0, 0, o.Title and 22 or 0),
        BackgroundColor3 = T.sunken, BorderSizePixel = 0,
    }, wrap)
    corner(bg, UDim.new(1, 0))
    local fill = inst("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = o.Color or T.accent, BorderSizePixel = 0,
    }, bg)
    corner(fill, UDim.new(1, 0))

    local function set(v)
        v = math.clamp(v or 0, 0, 1)
        tw(fill, {Size = UDim2.new(v, 0, 1, 0)})
        if pct then pct.Text = math.floor(v * 100 + 0.5) .. "%" end
    end
    set(o.Default or 0)

    return self:_Element(wrap, o, {
        get = function() return fill.Size.X.Scale end,
        set = set,
    })
end

function Lib:_CodeViewer(parent, o)
    o = o or {}
    local T = self.Theme
    local box = inst("Frame", {
        Size = UDim2.new(1, 0, 0, o.Height or 160),
        BackgroundColor3 = T.sunken, BorderSizePixel = 0, ClipsDescendants = true,
    }, parent)
    corner(box)
    stroke(box, T.border, 0.4)
    local sc = inst("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = T.borderStrong,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, box)
    pad(sc, T.md, T.md)
    local code = text(sc, {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Text = o.Text or "", Font = T.fMono, TextSize = T.fCode,
        TextColor3 = T.text, TextWrapped = true,
