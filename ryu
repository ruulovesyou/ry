    inst("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, T.sm),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, row)
    for i, bd in ipairs(list) do
        local base, hover, press, fg = styleOf(T, bd.Style)
        local b = inst("TextButton", {
            Size = UDim2.new(1 / n, -(T.sm * (n - 1) / n), 1, 0),
            BackgroundColor3 = base, BorderSizePixel = 0,
            Text = bd.Text or "Button", TextColor3 = fg,
