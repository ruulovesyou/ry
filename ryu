-- toggle ----------------------------------------------------------------
function Lib:_Toggle(parent, o)
    o = o or {}
    local T = self.Theme
    local lib = self
    local flag = o.Flag or o.Id
    local state = lib:_GetInitial(flag, o.Default and true or false) and true or false
    local bag = {}

    local row = inst("Frame", {
        Size = UDim2.new(1, 0, 0, T.rowH), BackgroundColor3 = T.surface, BorderSizePixel = 0,
    }, parent)
    corner(row)
    stroke(row, T.border, 0.4)
    text(row, {
        Size = UDim2.new(1, -64, 1, 0), Position = UDim2.fromOffset(T.md, 0),
        Text = o.Text or o.Title or "Toggle", Font = T.fm,
    })

    local track = inst("Frame", {
        Size = UDim2.fromOffset(36, 20),
        Position = UDim2.new(1, -T.md - 36, 0.5, -10),
        BackgroundColor3 = T.sunken, BorderSizePixel = 0,
    }, row)
    corner(track, UDim.new(1, 0))
    local trackStroke = stroke(track, T.border)
    local knob = inst("Frame", {
        Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(3, 3),
        BackgroundColor3 = T.textMuted, BorderSizePixel = 0,
    }, track)
    corner(knob, UDim.new(1, 0))

    local hb = inst("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, ZIndex = 2,
    }, row)
    focusRing(hb, bag)
    hb.MouseEnter:Connect(function() tw(row, {BackgroundColor3 = T.surfaceAlt}) end)
    hb.MouseLeave:Connect(function() tw(row, {BackgroundColor3 = T.surface}) end)

    local function paint()
        tw(track, {BackgroundColor3 = state and T.accent or T.sunken})
        tw(trackStroke, {Color = state and T.accent or T.border})
        tw(knob, {
            Position = state and UDim2.fromOffset(19, 3) or UDim2.fromOffset(3, 3),
            BackgroundColor3 = state and T.onAccent or T.textMuted,
        })
    end

    local function setState(v, fromFlag)
        v = v and true or false
        if v == state then return end
        state = v
        paint()
        if flag and not fromFlag then lib:SetFlag(flag, state) end
        if o.Callback then pcall(o.Callback, state) end
    end

    hb.MouseButton1Click:Connect(function() setState(not state) end)
    if flag then
        lib:OnFlagChanged(flag, function(v) if v ~= state then setState(v, true) end end)
    end
    paint()

    return self:_Element(row, o, {
        conns = bag,
        get = function() return state end,
        set = function(v) setState(v) end,
        refresh = paint,
    })
end

