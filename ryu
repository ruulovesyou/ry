    local flag = o.Flag or o.Id
    local current = o.Default or Color3.new(1, 1, 1)
    if flag then lib:SetFlag(flag, current) end

    local box = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 160),
        BackgroundColor3 = t.surface,
        BorderSizePixel = 0,
    }, parent)
    inst("UICorner", {CornerRadius = t.rSm}, box)
    inst("UIStroke", {Color = t.border, Thickness = 1, Transparency = 0.4}, box)

    inst("TextLabel", {
        Size = UDim2.new(1, -140, 0, 20),
        Position = UDim2.fromOffset(14, 4),
        BackgroundTransparency = 1,
        Text = o.Text or o.Title or "color",
        TextColor3 = t.text,
        Font = t.fm, TextSize = t.fMd,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, box)

    local swatch = inst("Frame", {
        Size = UDim2.fromOffset(60, 20),
        Position = UDim2.new(1, -74, 0, 4),
        BackgroundColor3 = current,
        BorderSizePixel = 0,
    }, box)
    inst("UICorner", {CornerRadius = t.rSm}, swatch)
    inst("UIStroke", {Color = t.border, Thickness = 1}, swatch)

    local hsv = inst("Frame", {
        Size = UDim2.new(1, -24, 0, 100),
        Position = UDim2.fromOffset(12, 30),
        BackgroundColor3 = Color3.fromRGB(255, 0, 0),
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, box)
    inst("UICorner", {CornerRadius = t.rSm}, hsv)

    local satOverlay = inst("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, hsv)
    inst("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
            ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)),
        }),
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Rotation = 0,
    }, satOverlay)

    local valOverlay = inst("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, hsv)
    inst("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.new(0, 0, 0)),
            ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)),
        }),
        Rotation = 90,
    }, valOverlay)

    local svKnob = inst("Frame", {
        Size = UDim2.fromOffset(10, 10),
        Position = UDim2.new(1, -5, 0, -5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 2,
    }, hsv)
    inst("UICorner", {CornerRadius = UDim.new(1, 0)}, svKnob)
    inst("UIStroke", {Color = Color3.new(0, 0, 0), Thickness = 1}, svKnob)

    local hueBar = inst("Frame", {
        Size = UDim2.new(1, -24, 0, 12),
        Position = UDim2.fromOffset(12, 138),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
    }, box)
    inst("UICorner", {CornerRadius = UDim.new(1, 0)}, hueBar)
    inst("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,0,0)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0,255,255)),
            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,0,0)),
        }),
        Rotation = 0,
    }, hueBar)

    local hKnob = inst("Frame", {
        Size = UDim2.fromOffset(10, 16),
        Position = UDim2.new(0, -5, 0.5, -8),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 2,
    }, hueBar)
    inst("UICorner", {CornerRadius = UDim.new(0, 3)}, hKnob)
    inst("UIStroke", {Color = Color3.new(0, 0, 0), Thickness = 1}, hKnob)

    local hue, s, v = 0, 1, 1

    local function paint(noFlag)
        current = Color3.fromHSV(hue, s, v)
        swatch.BackgroundColor3 = current
        hsv.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        svKnob.Position = UDim2.new(s, -5, 1 - v, -5)
        hKnob.Position = UDim2.new(hue, -5, 0.5, -8)
        if flag and not noFlag then lib:SetFlag(flag, current) end
        if o.Callback then pcall(o.Callback, current) end
    end

    local draggingSV, draggingHue
    local function updateSV(i)
        local relX = math.clamp((i.Position.X - hsv.AbsolutePosition.X) / hsv.AbsoluteSize.X, 0, 1)
        local relY = math.clamp((i.Position.Y - hsv.AbsolutePosition.Y) / hsv.AbsoluteSize.Y, 0, 1)
        s = relX; v = 1 - relY
        paint()
    end
    hsv.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingSV = true; updateSV(i)
        end
    end)
    hueBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingHue = true
            hue = math.clamp((i.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
            paint()
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if draggingSV and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            updateSV(i)
        elseif draggingHue and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            hue = math.clamp((i.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
            paint()
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            draggingSV = false; draggingHue = false
        end
    end)

    paint(true)

    if flag then
        lib:OnFlagChanged(flag, function(c)
            if typeof(c) == "Color3" and c ~= current then
                hue, s, v = Color3.toHSV(c)
                paint(true)
            end
        end)
    end

    return self:_Element(box, o, {
        get = function() return current end,
        set = function(c)
            if typeof(c) ~= "Color3" then return end
            hue, s, v = Color3.toHSV(c)
            paint()
        end,
        refresh = function() paint(true) end,
    })
end

function Lib:_ProgressBar(parent, o)
    o = o or {}
    local t = self.Theme
    local wrap = inst("Frame", {
        Size = UDim2.new(1, 0, 0, o.Title and 30 or 6),
        BackgroundTransparency = 1,
    }, parent)
    local bg
    if o.Title then
        inst("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16),
            BackgroundTransparency = 1,
            Text = o.Title,
            TextColor3 = t.textDim,
            Font = t.fm, TextSize = t.fSm,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, wrap)
        bg = inst("Frame", {
            Size = UDim2.new(1, 0, 0, 6),
            Position = UDim2.fromOffset(0, 20),
            BackgroundColor3 = t.surfaceAlt,
            BorderSizePixel = 0,
        }, wrap)
    else
        bg = inst("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = t.surfaceAlt,
            BorderSizePixel = 0,
        }, wrap)
    end
    inst("UICorner", {CornerRadius = UDim.new(1, 0)}, bg)
    local fill = inst("Frame", {
        Size = UDim2.new(o.Default or 0, 0, 1, 0),
        BackgroundColor3 = o.Color or t.accent,
        BorderSizePixel = 0,
    }, bg)
    inst("UICorner", {CornerRadius = UDim.new(1, 0)}, fill)

    return self:_Element(wrap, o, {
        get = function() return fill.Size.X.Scale end,
        set = function(v)
            v = math.clamp(v or 0, 0, 1)
            tw(fill, {Size = UDim2.new(v, 0, 1, 0)}, t.twFast)
        end,
    })
end

function Lib:_CodeViewer(parent, o)
    o = o or {}
    local t = self.Theme
    local box = inst("Frame", {
        Size = UDim2.new(1, 0, 0, o.Height or 160),
        BackgroundColor3 = t.surface,
        BorderSizePixel = 0,
    }, parent)
    inst("UICorner", {CornerRadius = t.rSm}, box)
    inst("UIStroke", {Color = t.border, Thickness = 1, Transparency = 0.4}, box)

    local scroll = inst("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -16),
        Position = UDim2.fromOffset(8, 8),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = t.border,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, box)

    local text = inst("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        Text = o.Text or "",
        TextColor3 = t.text,
        Font = t.fMono, TextSize = t.fSm,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, scroll)

    return self:_Element(box, o, {
        get = function() return text.Text end,
        set = function(v) text.Text = tostring(v) end,
        refresh = function() text.Text = o.Text or "" end,
    })
end

return Lib
