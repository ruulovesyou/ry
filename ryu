--[[
    Neutral UI Library — structural spec implementation
    - Rayfield-style sidebar rail + content card
    - WindUI-style per-element surface + title/desc
    - Fluent-style tween motion
    - Cascade-style hairlines + sparse accent
    - Venyx-style active indicators
    - LinoriaLib-style label-left / control-right grid
    - Obsidian-style config manager + flag system
    All theme tokens are overridable via Lib.Theme
]]

local TS  = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local HS  = game:GetService("HttpService")

local Lib = {}
Lib.__index = Lib

Lib.Theme = {
    bg          = Color3.fromRGB(18,18,22),
    surface     = Color3.fromRGB(26,26,32),
    surfaceAlt  = Color3.fromRGB(34,34,42),
    surfaceHover= Color3.fromRGB(42,42,52),
    border      = Color3.fromRGB(52,52,64),
    text        = Color3.fromRGB(232,232,238),
    textDim     = Color3.fromRGB(148,148,160),
    textMuted   = Color3.fromRGB(104,104,116),
    accent      = Color3.fromRGB(120,150,220),
    accentDim   = Color3.fromRGB(60,75,110),
    danger      = Color3.fromRGB(220,90,90),
    success     = Color3.fromRGB(90,200,140),
    warn        = Color3.fromRGB(230,180,80),
    rSm  = UDim.new(0,6),
    rMd  = UDim.new(0,8),
    rLg  = UDim.new(0,10),
    f    = Enum.Font.Gotham,
    fm   = Enum.Font.GothamMedium,
    fb   = Enum.Font.GothamBold,
    fMono= Enum.Font.Code,
    fSm  = 11,
    fMd  = 13,
    fLg  = 15,
    tw      = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    twFast  = TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    twSlow  = TweenInfo.new(0.30, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    pad  = 12,
    padL = 16,
}

local function inst(class, props, parent)
    local o = Instance.new(class)
    for k,v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function tw(o, props, ti)
    if not o or not o.Parent then return end
    local t = TS:Create(o, ti or Lib.Theme.tw, props)
    t:Play()
    return t
end

local function conn(bag, sig, fn)
    local c = sig:Connect(fn)
    table.insert(bag, c)
    return c
end

function Lib.new(opts)
    opts = opts or {}
    local self = setmetatable({}, Lib)
    self.Name     = opts.Name or "UI"
    self.Folder   = opts.Folder or "UILib"
    self._flags   = {}
    self._flagSigs= {}
    self._conns   = {}
    self._windows = {}

    if makefolder and isfolder and not isfolder(self.Folder) then
        pcall(makefolder, self.Folder)
    end
    if opts.AutoLoad and readfile then
        task.defer(function() self:LoadConfig(opts.AutoLoad) end)
    end
    return self
end

function Lib:GetFlag(name) return self._flags[name] end

function Lib:SetFlag(name, value)
    if not name then return end
    local prev = self._flags[name]
    self._flags[name] = value
    local sigs = self._flagSigs[name]
    if sigs then
        for _,fn in ipairs(sigs) do
            if prev ~= value then
                task.spawn(function() pcall(fn, value) end)
            end
        end
    end
end

function Lib:OnFlagChanged(name, fn)
    if not name then return end
    if not self._flagSigs[name] then self._flagSigs[name] = {} end
    table.insert(self._flagSigs[name], fn)
    return fn
end

function Lib:SaveConfig(name)
    name = name or "default"
    if not writefile then return end
    local data = {}
    for k,v in pairs(self._flags) do
        if type(v) ~= "function" and type(v) ~= "Instance" then
            data[k] = v
        end
    end
    pcall(function()
        writefile(self.Folder .. "/" .. name .. ".json", HS:JSONEncode(data))
    end)
    self:Notify({Title = "Config saved", Body = name, Type = "success"})
end

function Lib:LoadConfig(name)
    name = name or "default"
    if not readfile then return end
    local ok, data = pcall(function()
        return HS:JSONDecode(readfile(self.Folder .. "/" .. name .. ".json"))
    end)
    if not ok or type(data) ~= "table" then return end
    for k,v in pairs(data) do
        self:SetFlag(k, v)
    end
    self:Notify({Title = "Config loaded", Body = name, Type = "info"})
end

function Lib:DeleteConfig(name)
    name = name or "default"
    if not delfile then return end
    pcall(function() delfile(self.Folder .. "/" .. name .. ".json") end)
    self:Notify({Title = "Config deleted", Body = name, Type = "warn"})
end

function Lib:ListConfigs()
    if not listfiles then return {} end
    local out = {}
    local ok, files = pcall(function() return listfiles(self.Folder) end)
    if ok then
        for _,f in ipairs(files) do
            local n = f:match("([^/\\]+)%.json$")
            if n then table.insert(out, n) end
        end
    end
    return out
end

function Lib:_EnsureNotifStack()
    if self._notifStack and self._notifStack.Parent then return end
    local guiPar = (gethui and gethui()) or game:GetService("CoreGui")
    local container = inst("Frame", {
        Name = "_NotifStack",
        Size = UDim2.fromOffset(300, 500),
        Position = UDim2.new(1, -320, 1, -520),
        BackgroundTransparency = 1,
        ZIndex = 100,
    }, self._gui or guiPar)
    inst("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
    }, container)
    self._notifStack = container
end

function Lib:Notify(opts)
    opts = opts or {}
    self:_EnsureNotifStack()
    local t = self.Theme
    local card = inst("Frame", {
        Size = UDim2.fromOffset(280, 64),
        BackgroundColor3 = t.surface,
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
        ZIndex = 101,
    }, self._notifStack)
    inst("UICorner", {CornerRadius = t.rSm}, card)
    local stroke = inst("UIStroke", {Color = t.border, Thickness = 1, Transparency = 1}, card)

    local accent = t.accent
    if opts.Type == "warn" then accent = t.warn
    elseif opts.Type == "error" then accent = t.danger
    elseif opts.Type == "success" then accent = t.success end

    local bar = inst("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        BackgroundTransparency = 1,
        ZIndex = 102,
    }, card)

    local title = inst("TextLabel", {
        Size = UDim2.new(1, -24, 0, 22),
        Position = UDim2.fromOffset(14, 8),
        BackgroundTransparency = 1,
        Text = opts.Title or "notice",
        TextColor3 = t.text,
        Font = t.fb, TextSize = t.fMd,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTransparency = 1,
        ZIndex = 102,
    }, card)

    local body = inst("TextLabel", {
        Size = UDim2.new(1, -24, 0, 28),
        Position = UDim2.fromOffset(14, 30),
        BackgroundTransparency = 1,
        Text = opts.Body or "",
        TextColor3 = t.textDim,
        Font = t.f, TextSize = t.fSm,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        TextTransparency = 1,
        ZIndex = 102,
    }, card)

    tw(card,   {BackgroundTransparency = 0}, t.twFast)
    tw(stroke, {Transparency = 0}, t.twFast)
    tw(bar,    {BackgroundTransparency = 0}, t.twFast)
    tw(title,  {TextTransparency = 0}, t.twFast)
    tw(body,   {TextTransparency = 0}, t.twFast)

    task.delay(opts.Duration or 3, function()
        if not card.Parent then return end
        tw(card,   {BackgroundTransparency = 1}, t.twFast)
        tw(stroke, {Transparency = 1}, t.twFast)
        tw(bar,    {BackgroundTransparency = 1}, t.twFast)
        tw(title,  {TextTransparency = 1}, t.twFast)
        tw(body,   {TextTransparency = 1}, t.twFast)
        task.wait(0.15)
        if card.Parent then card:Destroy() end
    end)
    return card
end

