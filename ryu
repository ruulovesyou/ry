-- radio group ------------------------------------------------------------
function Lib:_RadioGroup(parent, o)
    o = o or {}
    local T = self.Theme
    local lib = self
    local flag = o.Flag or o.Id
    local options = o.Options or {}
    local current = lib:_GetInitial(flag, o.Default or options[1])
    local bag = {}

    local wrap = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    }, parent)
    vlist(wrap, 2)

    if o.Title then
        text(wrap, {
            Size = UDim2.new(1, 0, 0, 16), Text = o.Title, TextColor3 = T.textDim,
            Font = T.fm, TextSize = T.fCaption, LayoutOrder = 0,
        })
    end

    local rows = {}
    local function paint()
        for name, r in pairs(rows) do
            local on = name == current
            tw(r.dot, {BackgroundTransparency = on and 0 or 1})
            tw(r.ring, {Color = on and T.accent or T.borderStrong})
            r.label.TextColor3 = on and T.text or T.textDim
        end
    end

    local function setValue(v, fromFlag)
        if v == current then return end
        current = v
        paint()
        if flag and not fromFlag then lib:SetFlag(flag, current) end
        if o.Callback then pcall(o.Callback, current) end
    end

    for i, name in ipairs(options) do
        local row = inst("Frame", {
            Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, LayoutOrder = i,
        }, wrap)
        local ringF = inst("Frame", {
            Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, T.sm, 0.5, -7),
            BackgroundColor3 = T.sunken, BorderSizePixel = 0,
        }, row)
        corner(ringF, UDim.new(1, 0))
        local ringStroke = stroke(ringF, T.borderStrong)
        local dot = inst("Frame", {
            Size = UDim2.fromOffset(6, 6), Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = T.accent,
            BorderSizePixel = 0, BackgroundTransparency = 1,
        }, ringF)
        corner(dot, UDim.new(1, 0))
        local label = text(row, {
            Size = UDim2.new(1, -(T.sm + 14 + T.sm + T.md), 1, 0),
            Position = UDim2.fromOffset(T.sm + 14 + T.sm, 0),
            Text = name, TextColor3 = T.textDim, Font = T.fm,
        })
        local hb = inst("TextButton", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false, ZIndex = 2,
        }, row)
        focusRing(hb, bag)
        hb.MouseEnter:Connect(function() tw(label, {TextColor3 = T.text}) end)
        hb.MouseLeave:Connect(function()
            tw(label, {TextColor3 = name == current and T.text or T.textDim})
        end)
        hb.MouseButton1Click:Connect(function() setValue(name) end)
        rows[name] = {dot = dot, ring = ringStroke, label = label}
    end

    if flag then
        lib:OnFlagChanged(flag, function(v) if v ~= current then setValue(v, true) end end)
    end
    paint()

    return self:_Element(wrap, o, {
        conns = bag,
        get = function() return current end,
        set = function(v) setValue(v) end,
        refresh = paint,
    })
end

-- slider (arrow keys adjust while focused) -------------------------------
function Lib:_Slider(parent, o)
    o = o or {}
    local T = self.Theme
    local lib = self
    local flag = o.Flag or o.Id
    local mn, mx, step = o.Min or 0, o.Max or 100, o.Step or 1
    local suffix = o.Suffix or ""
    local val = math.clamp(lib:_GetInitial(flag, o.Default or mn), mn, mx)
    local bag = {}

    local box = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = T.surface, BorderSizePixel = 0,
    }, parent)
    corner(box)
    stroke(box, T.border, 0.4)
    text(box, {
        Size = UDim2.new(1, -90, 0, 18), Position = UDim2.fromOffset(T.md, 8),
        Text = o.Text or o.Title or "Slider", Font = T.fm,
    })
    local valLbl = text(box, {
        Size = UDim2.fromOffset(72, 18), Position = UDim2.new(1, -T.md - 72, 0, 8),
        TextColor3 = T.textDim, TextXAlignment = Enum.TextXAlignment.Right,
    })

    local track = inst("Frame", {
        Size = UDim2.new(1, -2 * T.md, 0, 4), Position = UDim2.new(0, T.md, 0, 34),
        BackgroundColor3 = T.sunken, BorderSizePixel = 0,
    }, box)
    corner(track, UDim.new(1, 0))
    local fill = inst("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.accent, BorderSizePixel = 0,
    }, track)
    corner(fill, UDim.new(1, 0))
    local knob = inst("Frame", {
        Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = T.text,
        BorderSizePixel = 0, ZIndex = 3,
    }, track)
    corner(knob, UDim.new(1, 0))

    -- invisible hit target over the track; focusable for keyboard
    local hit = inst("TextButton", {
        Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0, 0, 0, -10),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 4,
    }, track)
    focusRing(hit, bag)

    local function paint()
        local f = (val - mn) / (mx - mn)
        fill.Size = UDim2.new(f, 0, 1, 0)
        knob.Position = UDim2.new(f, 0, 0.5, 0)
        valLbl.Text = tostring(val) .. suffix
    end

    local function setVal(v, fromFlag)
        v = math.clamp(math.floor(v / step + 0.5) * step, mn, mx)
        if v == val then return end
        val = v
        paint()
        if flag and not fromFlag then lib:SetFlag(flag, val) end
        if o.Callback then pcall(o.Callback, val) end
    end

    local dragging, focused = false, false
    local function fromInput(i)
        local r = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        setVal(mn + r * (mx - mn))
    end

    hit.InputBegan:Connect(function(i)
        if isPress(i) then dragging = true; fromInput(i) end
    end)
    conn(bag, UIS.InputChanged, function(i)
        if dragging and isMove(i) then fromInput(i) end
    end)
    conn(bag, UIS.InputEnded, function(i)
        if isPress(i) then dragging = false end
    end)
    conn(bag, hit.SelectionGained, function() focused = true end)
    conn(bag, hit.SelectionLost, function() focused = false end)
    conn(bag, UIS.InputBegan, function(i, gp)
        if not focused or gp then return end
        if i.KeyCode == Enum.KeyCode.Left or i.KeyCode == Enum.KeyCode.Down then
            setVal(val - step)
        elseif i.KeyCode == Enum.KeyCode.Right or i.KeyCode == Enum.KeyCode.Up then
            setVal(val + step)
        end
    end)

    if flag then
        lib:OnFlagChanged(flag, function(v)
            if type(v) == "number" and v ~= val then setVal(v, true) end
        end)
    end
    paint()

    return self:_Element(box, o, {
        conns = bag,
        get = function() return val end,
        set = function(v) setVal(v) end,
        refresh = paint,
    })
end

-- range slider -----------------------------------------------------------
function Lib:_RangeSlider(parent, o)
    o = o or {}
    local T = self.Theme
    local lib = self
    local flag = o.Flag or o.Id
    local mn, mx, step = o.Min or 0, o.Max or 100, o.Step or 1
    local bag = {}

    local saved = flag and lib:GetFlag(flag)
    local lo, hi
    if type(saved) == "table" and saved[1] and saved[2] then
        lo, hi = saved[1], saved[2]
    else
        lo, hi = o.DefaultMin or mn, o.DefaultMax or mx
        if flag then lib:SetFlag(flag, {lo, hi}) end
    end

    local box = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = T.surface, BorderSizePixel = 0,
    }, parent)
    corner(box)
    stroke(box, T.border, 0.4)
    text(box, {
        Size = UDim2.new(1, -110, 0, 18), Position = UDim2.fromOffset(T.md, 8),
        Text = o.Text or o.Title or "Range", Font = T.fm,
    })
    local valLbl = text(box, {
        Size = UDim2.fromOffset(92, 18), Position = UDim2.new(1, -T.md - 92, 0, 8),
        TextColor3 = T.textDim, TextXAlignment = Enum.TextXAlignment.Right,
    })

    local track = inst("Frame", {
        Size = UDim2.new(1, -2 * T.md, 0, 4), Position = UDim2.new(0, T.md, 0, 34),
        BackgroundColor3 = T.sunken, BorderSizePixel = 0,
    }, box)
    corner(track, UDim.new(1, 0))
    local fill = inst("Frame", {BackgroundColor3 = T.accent, BorderSizePixel = 0}, track)
    corner(fill, UDim.new(1, 0))

    local function mkKnob()
        local k = inst("Frame", {
            Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = T.text, BorderSizePixel = 0, ZIndex = 3,
        }, track)
        corner(k, UDim.new(1, 0))
        return k
    end
    local kLo, kHi = mkKnob(), mkKnob()

    local function snap(v)
        v = math.floor(v / step + 0.5) * step
        return math.clamp(v, mn, mx)
    end

    local function paint()
        local a = (lo - mn) / (mx - mn)
        local b = (hi - mn) / (mx - mn)
        fill.Position = UDim2.new(a, 0, 0, 0)
        fill.Size = UDim2.new(b - a, 0, 1, 0)
        kLo.Position = UDim2.new(a, 0, 0.5, 0)
        kHi.Position = UDim2.new(b, 0, 0.5, 0)
        valLbl.Text = tostring(lo) .. " – " .. tostring(hi)
    end

    local active
    local function fromInput(i)
        local r = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local v = snap(mn + r * (mx - mn))
        if active == "lo" then lo = math.min(v, hi)
        elseif active == "hi" then hi = math.max(v, lo) end
        paint()
        if flag then lib:SetFlag(flag, {lo, hi}) end
        if o.Callback then pcall(o.Callback, lo, hi) end
    end

    -- each knob gets its own hit target so both are keyboard-selectable
    local function hitFor(k, which)
        local h = inst("TextButton", {
            Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false, ZIndex = 4,
        }, k)
        focusRing(h, bag)
        h.InputBegan:Connect(function(i)
            if isPress(i) then active = which; fromInput(i) end
        end)
        return h
    end
    hitFor(kLo, "lo")
    hitFor(kHi, "hi")

    conn(bag, UIS.InputChanged, function(i)
        if active and isMove(i) then fromInput(i) end
    end)
    conn(bag, UIS.InputEnded, function(i)
        if isPress(i) then active = nil end
    end)

    if flag then
        lib:OnFlagChanged(flag, function(v)
            if type(v) == "table" and v[1] and v[2] then
                lo, hi = v[1], v[2]
                paint()
            end
        end)
    end
    paint()

    return self:_Element(box, o, {
        conns = bag,
        get = function() return lo, hi end,
        set = function(l, h)
            lo = snap(l or lo)
            if h then hi = snap(h) end
            paint()
        end,
        refresh = paint,
    })
end

