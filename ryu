function Lib:_Element(frame, opts, internal)
    local el = {
        Frame = frame,
        Flag = opts.Flag or opts.Id,
        _lib = self,
        _opts = opts,
        _locked = false,
        _visible = true,
        _get = internal.get,
        _set = internal.set,
        _refresh = internal.refresh,
    }
    function el:Set(v)
        if self._locked then return end
        if self._set then self._set(v) end
    end
    function el:Get() if self._get then return self._get() end end
    function el:SetVisible(v)
        self._visible = v ~= false
        frame.Visible = self._visible
    end
    function el:SetLocked(v)
        self._locked = v ~= false
        frame.Active = not self._locked
    end
    function el:Destroy() if frame.Parent then frame:Destroy() end end
    function el:Refresh() if self._refresh then self._refresh() end end
    return el
end

