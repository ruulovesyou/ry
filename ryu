-- segmented control: one visual language for "pick a view"
function Lib:_SubTabs(parent, names)
    local T = self.Theme
    local wrap = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    }, parent)
    vlist(wrap, T.sm)

    local bar = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.sunken,
        BorderSizePixel = 0, LayoutOrder = 0,
    }, wrap)
    corner(bar)
    stroke(bar, T.border, 0.4)
    pad(bar, 3, 3)
    inst("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, bar)

    local content = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = 1,
    }, wrap)

    local pages, buttons, active = {}, {}, nil
    local lib = self

    local function setActive(n)
        active = n
        for name, b in pairs(buttons) do
            local on = name == n
            tw(b, {BackgroundColor3 = on and T.surfaceAlt or T.sunken})
            b.TextColor3 = on and T.text or T.textDim
            pages[name].Visible = on
        end
    end

    for i, name in ipairs(names) do
        local page = inst("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Visible = false,
        }, content)
        vlist(page, T.sm)
        pages[name] = page

        local b = inst("TextButton", {
            Size = UDim2.new(1 / #names, -2, 1, 0), BackgroundColor3 = T.sunken,
            BorderSizePixel = 0, Text = name, TextColor3 = T.textDim,
            Font = T.fm, TextSize = T.fCaption + 1, AutoButtonColor = false, LayoutOrder = i,
        }, bar)
        corner(b)
        buttons[name] = b
        focusRing(b, {})
        b.MouseEnter:Connect(function()
            if active ~= name then tw(b, {BackgroundColor3 = T.surfaceHover}) end
        end)
        b.MouseLeave:Connect(function()
            if active ~= name then tw(b, {BackgroundColor3 = T.sunken}) end
        end)
        b.MouseButton1Click:Connect(function() setActive(name) end)
    end
    setActive(names[1])

    return {
        Pages = pages,
        Bar = bar,
        Switch = setActive,
        GetActive = function() return active end,
        Page = function(_, name)
            local p = pages[name]
            if p then return lib:_MakeAPI(p) end
        end,
    }
end

-- element base ----------------------------------------------------------
function Lib:_Element(frame, opts, internal)
    internal = internal or {}
    local el = {
        Frame    = frame,
        Flag     = opts.Flag or opts.Id,
        _lib     = self,
        _locked  = false,
        _visible = true,
        _conns   = internal.conns or {},
        _get     = internal.get,
        _set     = internal.set,
        _refresh = internal.refresh,
    }
    function el:Set(...)
        if self._locked then return end
        if self._set then self._set(...) end
    end
    function el:Get()
        if self._get then return self._get() end
    end
    function el:SetVisible(v)
        self._visible = v ~= false
        frame.Visible = self._visible
    end
    function el:SetLocked(v)
        self._locked = v ~= false
        local locked = self._locked
        local nodes = {frame}
        for _, d in ipairs(frame:GetDescendants()) do table.insert(nodes, d) end
        for _, d in ipairs(nodes) do
            if d:IsA("GuiButton") or d:IsA("TextBox") then d.Active = not locked end
            if d:IsA("TextLabel") or d:IsA("TextButton") then
                d.TextTransparency = locked and 0.5 or 0
            end
        end
    end
    function el:Destroy()
        for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
        self._conns = {}
        if frame.Parent then frame:Destroy() end
    end
    function el:Refresh()
        if self._refresh then self._refresh() end
    end
    return el
end

