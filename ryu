-- dropdown ---------------------------------------------------------------
function Lib:_Dropdown(parent, o)
    o = o or {}
    local T = self.Theme
    local lib = self
    local flag = o.Flag or o.Id
    local multi = o.Multi and true or false
    local searchable = o.Searchable and true or false
    local bag = {}

    local opts = {}
    for i, v in ipairs(o.Options or {}) do opts[i] = v end

    local current = lib:_GetInitial(flag, multi and {} or (o.Default or opts[1] or ""))
    if multi and type(current) ~= "table" then current = {} end

    local function isEmpty()
        if multi then return next(current) == nil end
        return current == nil or current == ""
    end

    local open = false
    local box = inst("Frame", {
        Size = UDim2.new(1, 0, 0, T.rowH), BackgroundColor3 = T.surface,
        BorderSizePixel = 0, ZIndex = 2,
    }, parent)
    corner(box)
    stroke(box, T.border, 0.4)

    text(box, {
        Size = UDim2.new(0.42, 0, 1, 0), Position = UDim2.fromOffset(T.md, 0),
        Text = o.Text or o.Title or "Dropdown", TextColor3 = T.textDim, ZIndex = 3,
    })
    local valLbl = text(box, {
        Size = UDim2.new(0.58, -(T.md + 22), 1, 0), Position = UDim2.new(0.42, 0, 0, 0),
        Font = T.fm, TextXAlignment = Enum.TextXAlignment.Right,
        TruncateEnd = nil, ZIndex = 3,
    })
    valLbl.TextTruncate = Enum.TextTruncate.AtEnd
    local chev = text(box, {
        Size = UDim2.fromOffset(14, T.rowH), Position = UDim2.new(1, -T.md - 14, 0, 0),
        Text = "▾", TextColor3 = T.textMuted, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3,
    })

    local function paint()
        local empty = isEmpty()
        if multi then
            local n = 0
            for _ in pairs(current) do n = n + 1 end
            valLbl.Text = n == 0 and "None" or (n .. " selected")
        else
            valLbl.Text = empty and "Select…" or tostring(current)
        end
        valLbl.TextColor3 = empty and T.textMuted or T.text
    end

    -- header hit target
    local head = inst("TextButton", {
        Size = UDim2.new(1, 0, 0, T.rowH), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, ZIndex = 4,
    }, box)
    focusRing(head, bag)
    head.MouseEnter:Connect(function() tw(box, {BackgroundColor3 = T.surfaceAlt}) end)
    head.MouseLeave:Connect(function() tw(box, {BackgroundColor3 = T.surface}) end)

    -- panel
    local list = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, T.rowH + 4),
        BackgroundColor3 = T.surfaceAlt, BorderSizePixel = 0,
        Visible = false, ZIndex = 10, ClipsDescendants = true,
    }, box)
    corner(list)
    stroke(list, T.borderStrong, 0.2)

    local top = 0
    local searchBox
    if searchable then
        searchBox = inst("TextBox", {
            Size = UDim2.new(1, -8, 0, 28), Position = UDim2.fromOffset(4, 4),
            BackgroundColor3 = T.sunken, BorderSizePixel = 0, Text = "",
            PlaceholderText = "Search…", PlaceholderColor3 = T.textMuted,
            TextColor3 = T.text, Font = T.f, TextSize = T.fBody,
            TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ZIndex = 11,
        }, list)
        corner(searchBox)
        pad(searchBox, T.sm, 0)
        top = 32
    end

    local scroller = inst("ScrollingFrame", {
        Size = UDim2.new(1, -8, 0, 0), Position = UDim2.fromOffset(4, 4 + top),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, ScrollBarImageColor3 = T.borderStrong,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 11,
    }, list)
    vlist(scroller, 2)

    local rowsBuilt = {}

    local function resize()
        local rows = math.max(#rowsBuilt, 1)
        local visible = math.min(rows, 7)
        scroller.Size = UDim2.new(1, -8, 0, visible * 30 - 2)
        local listH = top + 4 + visible * 30 + 2
        list.Size = UDim2.new(1, 0, 0, listH)
        box.Size = UDim2.new(1, 0, 0, T.rowH + 4 + listH)
    end

    local function rebuild(filter)
        for _, r in ipairs(rowsBuilt) do r:Destroy() end
        rowsBuilt = {}
        filter = (filter or ""):lower()
        local shown = 0

        for i, opt in ipairs(opts) do
            local s = tostring(opt)
            if filter == "" or s:lower():find(filter, 1, true) then
                shown = shown + 1
                local sel = multi and current[opt] and true or (not multi and current == opt)
                local ob = inst("TextButton", {
                    Size = UDim2.new(1, 0, 0, 28),
                    BackgroundColor3 = sel and T.accentSoft or T.surfaceAlt,
                    BorderSizePixel = 0, Text = "", AutoButtonColor = false,
                    LayoutOrder = i, ZIndex = 12,
                }, scroller)
                corner(ob)
                hoverable(ob, sel and T.accentSoft or T.surfaceAlt, T.surfaceHover, T.surfaceHover)
                focusRing(ob, {})
                text(ob, {
                    Size = UDim2.new(1, -36, 1, 0), Position = UDim2.fromOffset(T.sm, 0),
                    Text = s, TextColor3 = sel and T.text or T.textDim,
                    Font = sel and T.fm or T.f, ZIndex = 12,
                })
                if sel then
                    text(ob, {
                        Size = UDim2.fromOffset(16, 28), Position = UDim2.new(1, -T.sm - 16, 0, 0),
                        Text = "✓", TextColor3 = T.accent, Font = T.fb,
                        TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 12,
                    })
                end
                ob.MouseButton1Click:Connect(function()
                    if multi then
                        current[opt] = (not current[opt]) and true or nil
                        paint()
                        if flag then lib:SetFlag(flag, current) end
                        if o.Callback then pcall(o.Callback, current) end
                        rebuild(searchBox and searchBox.Text or "")
                        resize()
                    else
                        current = opt
                        paint()
                        setOpen(false)
                        if flag then lib:SetFlag(flag, current) end
                        if o.Callback then pcall(o.Callback, current) end
                    end
                end)
                table.insert(rowsBuilt, ob)
            end
        end

        if shown == 0 then
            local empty = text(scroller, {
                Size = UDim2.new(1, 0, 0, 28),
                Text = #opts == 0 and "No options" or "No matches",
                TextColor3 = T.textMuted, TextXAlignment = Enum.TextXAlignment.Center,
                LayoutOrder = 1, ZIndex = 12,
            })
            table.insert(rowsBuilt, empty)
        end
    end

    function setOpen(v)
        open = v and true or false
        list.Visible = open
        chev.Text = open and "▴" or "▾"
        if open then
            rebuild(searchBox and searchBox.Text or "")
            resize()
        else
            box.Size = UDim2.new(1, 0, 0, T.rowH)
        end
    end

    head.MouseButton1Click:Connect(function() setOpen(not open) end)
    if searchBox then
        searchBox:GetPropertyChangedSignal("Text"):Connect(function()
            rebuild(searchBox.Text)
            resize()
        end)
    end

    if flag then
        lib:OnFlagChanged(flag, function(v)
            if multi then
                if type(v) == "table" then current = v end
            else
                current = v
            end
            paint()
        end)
    end
    paint()

    return self:_Element(box, o, {
        conns = bag,
        get = function() return current end,
        set = function(v)
            if multi then
                if type(v) == "table" then current = v end
            else
                current = v
            end
            paint()
        end,
        refresh = function()
            paint()
            if open then rebuild(searchBox and searchBox.Text or ""); resize() end
        end,
    })
end

-- text inputs with status ------------------------------------------------
function Lib:_Textbox(parent, o)
    o = o or {}
    local T = self.Theme
    local lib = self
    local flag = o.Flag or o.Id
    local init = lib:_GetInitial(flag, o.Default or "")
    if type(init) ~= "string" then init = tostring(init) end

    local wrap, box, st, hint = field(parent)
    local tb = inst("TextBox", {
        Size = UDim2.new(1, -2 * T.md, 1, 0), Position = UDim2.fromOffset(T.md, 0),
        BackgroundTransparency = 1, Text = init,
        PlaceholderText = o.Placeholder or "Type…", PlaceholderColor3 = T.textMuted,
        TextColor3 = T.text, Font = T.f, TextSize = T.fBody,
        TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
    }, box)

    local focused, status = false, nil
    local function paint()
        local c = T.border
        if status == "error" then c = T.danger
        elseif status == "success" then c = T.success
        elseif focused then c = T.accent end
        tw(st, {Color = c})
    end
    local function setStatus(kind, msg)
        status = kind
        hint.Text = msg or ""
        hint.Visible = msg ~= nil and msg ~= ""
        hint.TextColor3 = (kind == "error" and T.danger)
            or (kind == "success" and T.success) or T.textMuted
        paint()
    end

    tb.Focused:Connect(function() focused = true; paint() end)
    tb.FocusLost:Connect(function()
        focused = false
        if flag then lib:SetFlag(flag, tb.Text) end
        if o.Callback then pcall(o.Callback, tb.Text) end
        paint()
    end)

    if flag then
        lib:OnFlagChanged(flag, function(v)
            if type(v) == "string" and v ~= tb.Text then tb.Text = v end
        end)
    end

    local el = self:_Element(wrap, o, {
        get = function() return tb.Text end,
        set = function(v) tb.Text = tostring(v) end,
    })
    function el:SetStatus(kind, msg) setStatus(kind, msg) end
    return el
end

function Lib:_NumberInput(parent, o)
    o = o or {}
    local T = self.Theme
    local lib = self
    local flag = o.Flag or o.Id
    local init = lib:_GetInitial(flag, o.Default or 0)
    if type(init) ~= "number" then init = tonumber(init) or 0 end
    local lastValid = init

    local wrap, box, st, hint = field(parent)
    local tb = inst("TextBox", {
        Size = UDim2.new(1, -2 * T.md, 1, 0), Position = UDim2.fromOffset(T.md, 0),
        BackgroundTransparency = 1, Text = tostring(init),
        PlaceholderText = o.Placeholder or "0", PlaceholderColor3 = T.textMuted,
        TextColor3 = T.text, Font = T.fm, TextSize = T.fBody,
        TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
    }, box)

    local focused, status = false, nil
    local function paint()
        local c = T.border
        if status == "error" then c = T.danger
        elseif status == "success" then c = T.success
        elseif focused then c = T.accent end
        tw(st, {Color = c})
    end
    local function setStatus(kind, msg)
        status = kind
        hint.Text = msg or ""
        hint.Visible = msg ~= nil and msg ~= ""
        hint.TextColor3 = (kind == "error" and T.danger)
            or (kind == "success" and T.success) or T.textMuted
        paint()
    end

    tb.Focused:Connect(function() focused = true; paint() end)
    tb.FocusLost:Connect(function()
        focused = false
        local n = tonumber(tb.Text)
        if not n then
            setStatus("error", "Enter a number")
            return
        end
        if o.Min then n = math.max(o.Min, n) end
        if o.Max then n = math.min(o.Max, n) end
        tb.Text = tostring(n)
        lastValid = n
        setStatus(nil)
        if flag then lib:SetFlag(flag, n) end
        if o.Callback then pcall(o.Callback, n) end
    end)

    if flag then
        lib:OnFlagChanged(flag, function(v)
            if type(v) == "number" and v ~= lastValid then
                lastValid = v
                tb.Text = tostring(v)
            end
        end)
    end
    paint()

    local el = self:_Element(wrap, o, {
        get = function() return tonumber(tb.Text) or lastValid end,
        set = function(v)
            if type(v) == "number" then
                tb.Text = tostring(v)
                lastValid = v
            end
        end,
    })
    function el:SetStatus(kind, msg) setStatus(kind, msg) end
    return el
end

