function Lib:_Keybind(parent, o)
    o = o or {}
    local t = self.Theme
    local lib = self
    local flag = o.Flag or o.Id
    local mode = o.Mode or "tap"
    local key = o.Default

    local row = inst("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = t.surface,
        BorderSizePixel = 0,
    }, parent)
    inst("UICorner", {CornerRadius = t.rSm}, row)
    inst("UIStroke", {Color = t.border, Thickness = 1, Transparency = 0.4}, row)

    inst("TextLabel", {
        Size = UDim2.new(1, -100, 1, 0),
        Position = UDim2.fromOffset(14, 0),
        BackgroundTransparency = 1,
        Text = o.Text or o.Title or "keybind",
        TextColor3 = t.text,
        Font = t.fm, TextSize = t.fMd,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local chip = inst("TextButton", {
        Size = UDim2.fromOffset(80, 22),
        Position = UDim2.new(1, -92, 0.5, -11),
        BackgroundColor3 = t.surfaceAlt,
        BorderSizePixel = 0,
        Text = key and tostring(key.Name or key) or "—",
        TextColor3 = t.text,
        Font = t.fm, TextSize = t.fSm,
        AutoButtonColor = false,
    }, row)
    inst("UICorner", {CornerRadius = t.rSm}, chip)

    local listening = false
    chip.MouseButton1Click:Connect(function()
        listening = true
        chip.Text = "press..."
    end)

    UIS.InputBegan:Connect(function(input, gp)
        if listening then
            listening = false
            key = input.KeyCode
            chip.Text = tostring(key.Name)
            if flag then lib:SetFlag(flag, key.Name) end
            if o.Callback then pcall(o.Callback, key, false) end
            return
        end
        if key and input.KeyCode == key and not gp then
            if o.Callback then pcall(o.Callback, key, true) end
        end
    end)
    if mode == "hold" then
        UIS.InputEnded:Connect(function(input)
            if key and input.KeyCode == key then
                if o.OnRelease then pcall(o.OnRelease, key) end
            end
        end)
    end

    if flag then
        lib:SetFlag(flag, key and key.Name or nil)
        lib:OnFlagChanged(flag, function(v)
            if type(v) == "string" then
                for _, k in pairs(Enum.KeyCode:GetEnumItems()) do
                    if k.Name == v then key = k; chip.Text = v; break end
                end
            end
        end)
    end
    return self:_Element(row, o, {
        get = function() return key end,
        set = function(v)
            if type(v) == "userdata" then key = v
            elseif type(v) == "string" then
                for _, k in pairs(Enum.KeyCode:GetEnumItems()) do
                    if k.Name == v then key = k; break end
                end
            end
            chip.Text = key and tostring(key.Name) or "—"
        end,
    })
end

