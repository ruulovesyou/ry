        TextColor3 = t.textDim,
        Font = t.fm, TextSize = t.fMd,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, box)

    local trackBg = inst("Frame", {
        Size = UDim2.new(1, -28, 0, 6),
        Position = UDim2.new(0, 14, 0, 34),
        BackgroundColor3 = t.surfaceAlt,
        BorderSizePixel = 0,
    }, box)
    inst("UICorner", {CornerRadius = UDim.new(1, 0)}, trackBg)

    local fill = inst("Frame", {
        Size = UDim2.new((hi-lo)/(mx-mn), 0, 1, 0),
        Position = UDim2.new((lo-mn)/(mx-mn), 0, 0, 0),
        BackgroundColor3 = t.accent,
        BorderSizePixel = 0,
    }, trackBg)
    inst("UICorner", {CornerRadius = UDim.new(1, 0)}, fill)

    local kLo = inst("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new((lo-mn)/(mx-mn), -7, 0.5, -7),
        BackgroundColor3 = t.text,
        BorderSizePixel = 0,
    }, trackBg)
    inst("UICorner", {CornerRadius = UDim.new(1, 0)}, kLo)

    local kHi = inst("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new((hi-mn)/(mx-mn), -7, 0.5, -7),
        BackgroundColor3 = t.text,
        BorderSizePixel = 0,
    }, trackBg)
    inst("UICorner", {CornerRadius = UDim.new(1, 0)}, kHi)

    local function paint()
        local tl = (lo - mn) / (mx - mn)
        local th = (hi - mn) / (mx - mn)
        fill.Position = UDim2.new(tl, 0, 0, 0)
        fill.Size = UDim2.new(th - tl, 0, 1, 0)
        kLo.Position = UDim2.new(tl, -7, 0.5, -7)
        kHi.Position = UDim2.new(th, -7, 0.5, -7)
        valLbl.Text = tostring(lo) .. " – " .. tostring(hi)
    end

    local activeHandle = nil
    local function update(i)
        local r = math.clamp((i.Position.X - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
        local v = math.floor(mn + r * (mx - mn))
        if activeHandle == "lo" then
            lo = math.min(v, hi)
        elseif activeHandle == "hi" then
            hi = math.max(v, lo)
        end
        paint()
        if flag then lib:SetFlag(flag, {lo, hi}) end
        if o.Callback then pcall(o.Callback, lo, hi) end
    end
    kLo.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            activeHandle = "lo"; update(i)
        end
    end)
    kHi.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            activeHandle = "hi"; update(i)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if activeHandle and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            activeHandle = nil
        end
    end)

    paint()
    return self:_Element(box, o, {
        get = function() return lo, hi end,
        set = function(v, hi2) lo = v; if hi2 then hi = hi2 end; paint() end,
        refresh = paint,
    })
end

