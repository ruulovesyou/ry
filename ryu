-- buttons ---------------------------------------------------------------
function Lib:_Button(parent, o)
    o = o or {}
    local T = self.Theme
    local base, hover, press, fg = styleOf(T, o.Style)
    local label = o.Text or o.Title or "Button"
    local bag = {}

    local b = inst("TextButton", {
        Size = UDim2.new(1, 0, 0, o.Height or T.rowH),
        BackgroundColor3 = base, BorderSizePixel = 0,
        Text = label, TextColor3 = fg, Font = T.fm, TextSize = T.fBody,
        AutoButtonColor = false,
    }, parent)
    corner(b)
    if (o.Style or "secondary") == "secondary" then stroke(b, T.border, 0.3) end
    hoverable(b, base, hover, press)
    focusRing(b, bag)

    local el = self:_Element(b, o, {conns = bag})
    local busy = false

    function el:SetLoading(v)
        busy = v and true or false
        b.Text = busy and (o.LoadingText or "Working…") or label
        b.Active = not busy and not self._locked
    end

    b.MouseButton1Click:Connect(function()
        if busy or el._locked then return end
        if o.Callback then
            local ok, err = pcall(o.Callback)
            if not ok then warn("[UI]", err) end
        end
    end)
    return el
end

function Lib:_ConfirmButton(parent, o)
    o = o or {}
    local lib = self
    local cb = o.Callback
    local wrapped = {}
    for k, v in pairs(o) do wrapped[k] = v end
    wrapped.Callback = function()
        lib:Dialog({
            Title = o.ConfirmTitle or "Confirm",
            Body = o.ConfirmBody or "Are you sure?",
            ConfirmText = o.ConfirmText or "Confirm",
            CancelText = "Cancel",
            Danger = o.Danger == true,
            OnConfirm = cb,
        })
    end
    return self:_Button(parent, wrapped)
end

function Lib:_ButtonRow(parent, o)
    o = o or {}
