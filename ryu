        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local track = inst("Frame", {
        Size = UDim2.fromOffset(40, 20),
        Position = UDim2.new(1, -52, 0.5, -10),
        BackgroundColor3 = t.surfaceAlt,
        BorderSizePixel = 0,
    }, row)
    inst("UICorner", {CornerRadius = UDim.new(1, 0)}, track)
    local trackStroke = inst("UIStroke", {Color = t.border, Thickness = 1}, track)

    local knob = inst("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = t.textDim,
        BorderSizePixel = 0,
    }, track)
    inst("UICorner", {CornerRadius = UDim.new(1, 0)}, knob)

    local hb = inst("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false,
    }, row)

    local function paint()
        if state then
            tw(track, {BackgroundColor3 = t.accent})
            tw(trackStroke, {Color = t.accent})
            tw(knob, {Position = UDim2.new(1, -18, 0.5, -8), BackgroundColor3 = t.text})
        else
            tw(track, {BackgroundColor3 = t.surfaceAlt})
            tw(trackStroke, {Color = t.border})
            tw(knob, {Position = UDim2.new(0, 2, 0.5, -8), BackgroundColor3 = t.textDim})
        end
    end

    local function setState(v, fromFlag)
        v = v and true or false
        if v == state then return end
        state = v
        paint()
        if flag and not fromFlag then lib:SetFlag(flag, state) end
        if o.Callback then pcall(o.Callback, state) end
