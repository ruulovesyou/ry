    function sec:Spacer(h)        return self.Lib:_Spacer(container, h) end
    function sec:ProgressBar(o)   return self.Lib:_ProgressBar(container, o) end
    function sec:Image(o)         return self.Lib:_Image(container, o) end
    function sec:CodeViewer(o)    return self.Lib:_CodeViewer(container, o) end
    function sec:Section(n,o)
        if o and o.Collapsible then
            local c = self.Lib:_Collapsible(container, n, o.DefaultOpen)
            return self.Lib:_MakeSectionAPI(c.Container)
        else
            local box = self.Lib:_GroupBox(container, n)
            return self.Lib:_MakeSectionAPI(box)
        end
    end
    return sec
end

